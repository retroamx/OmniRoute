+import os
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).parent.parent))
+
+import data_paths
+import session_watch
+
+
+def test_tool_token_survives_a_second_start_without_posix_file_apis(tmp_path, monkeypatch):
+    """Windows has no O_NOFOLLOW / getuid / fchmod. The token file's second read used to raise
+    AttributeError there, so JARVIS crashed the second time it started."""
+    monkeypatch.setenv("JARVIS_DATA_DIR", str(tmp_path))
+    for name in ("O_NOFOLLOW", "getuid", "fchmod"):
+        monkeypatch.delattr(os, name, raising=False)
+    first = data_paths.ensure_tool_token()
+    second = data_paths.ensure_tool_token()
+    assert first and first == second
+
+
+def test_tool_token_without_posix_apis_refuses_a_symlink(tmp_path, monkeypatch):
+    monkeypatch.setenv("JARVIS_DATA_DIR", str(tmp_path))
+    for name in ("O_NOFOLLOW", "getuid", "fchmod"):
+        monkeypatch.delattr(os, name, raising=False)
+    data_paths.ensure_tool_token()
+    path = data_paths.tool_token_path()
+    target = tmp_path / "elsewhere"
+    target.write_text("not-our-token")
+    path.unlink()
+    try:
+        path.symlink_to(target)
+    except (OSError, NotImplementedError):
+        return                                   # symlinks unavailable on this platform: nothing to check
+    try:
+        data_paths.ensure_tool_token()
+    except OSError:
+        return
+    raise AssertionError("a symlinked token file must be refused")
+
+
+def test_pid_alive_never_calls_os_kill_on_windows(monkeypatch):
+    """os.kill(pid, 0) terminates the process on Windows. It must never be the probe there."""
+    calls = []
+    monkeypatch.setattr(session_watch, "_IS_WINDOWS", True)
+    monkeypatch.setattr(session_watch, "_pid_alive_windows", lambda pid: calls.append(pid) or True)
+    monkeypatch.setattr(os, "kill", lambda *a, **k: (_ for _ in ()).throw(AssertionError("os.kill was called")))
+    assert session_watch.pid_alive(4242) is True
+    assert calls == [4242]
+
+
+def test_pid_alive_posix_behaviour_is_unchanged(monkeypatch):
+    monkeypatch.setattr(session_watch, "_IS_WINDOWS", False)
+    assert session_watch.pid_alive(os.getpid()) is True
+    assert session_watch.pid_alive(0) is False
+    assert session_watch.pid_alive(-5) is False
+    assert session_watch.pid_alive("abc") is False
+    assert session_watch.pid_alive(2 ** 22 + 12345) is False
+
+
+def test_usage_scan_imports_and_bounds_hold_on_windows(monkeypatch):
+    """`datetime(2, 1, 1).timestamp()` raised OSError at import on Windows, so the server never started."""
+    import importlib
+    import usage_scan
+    monkeypatch.setattr(os, "name", "nt")
+    mod = importlib.reload(usage_scan)
+    try:
+        assert mod._DAY_MIN > 0                                  # Windows fromtimestamp rejects negatives
+        assert mod._DAY_MAX < 32536799999                        # ...and anything past year 3000
+        assert mod._epoch("1970-01-01T00:00:00.000Z") is None    # too close to the epoch to place locally
+        assert mod._epoch("2026-09-29T10:00:00.000Z") is not None
+    finally:
+        monkeypatch.setattr(os, "name", "posix")
+        importlib.reload(usage_scan)
+
+
+def test_usage_scan_bounds_unchanged_off_windows():
+    import usage_scan
+    assert usage_scan._epoch("0001-01-01T00:00:00.000Z") is None
+    assert usage_scan._epoch("2026-09-29T10:00:00.000Z") is not None
+
+
+def test_reset_time_wording_uses_no_platform_specific_strftime_flags():
+    """`%-I` and `%-d` raise ValueError on Windows; the spoken wording must not depend on them."""
+    from datetime import datetime, timedelta
+    import server
+    base = datetime.now().replace(hour=10, minute=0, second=0, microsecond=0)
+    assert server._fmt_reset((base + timedelta(days=1)).timestamp()) == "tomorrow at 10 AM"
+    far = base + timedelta(days=9)
+    assert server._fmt_reset(far.timestamp()) == f"{far.strftime('%A')} {far.day} {far.strftime('%B')} at 10 AM"
+    assert server._fmt_reset(base.replace(hour=15, minute=30).timestamp() + 86400).endswith("3:30 PM")
+
+
+def test_steer_without_unix_sockets_fails_cleanly(monkeypatch, tmp_path):
+    import socket
+    import session_steer
+    sock_file = tmp_path / "s.sock"
+    sock_file.write_text("")                 # present, so the call gets as far as opening a socket
+    monkeypatch.delattr(socket, "AF_UNIX", raising=False)
+    assert session_steer.post_to_session(str(sock_file), "hola") == session_steer.FAILED
