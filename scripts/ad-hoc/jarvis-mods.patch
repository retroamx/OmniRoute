+.hud-chip.dim { color: var(--faint); }
+.hud-sys { display: flex; gap: 12px; }
+.hud-sys-item { display: inline-flex; align-items: center; gap: 6px; font-family: var(--f-ui); font-size: 10.5px; font-weight: 700; letter-spacing: 2px; color: var(--faint); cursor: default; }
+.hud-sys-item::before { content: ""; width: 6px; height: 6px; transform: rotate(45deg); background: #56657a; }
+.hud-sys-item[data-state="ok"] { color: var(--dim); }
+.hud-sys-item[data-state="ok"]::before { background: var(--ok); box-shadow: 0 0 6px var(--ok); }
+.hud-sys-item[data-state="warn"]::before { background: var(--warn); box-shadow: 0 0 6px var(--warn); animation: hud-blink 1.2s infinite; }
+.hud-sys-item[data-state="bad"] { color: #ffb3bf; }
+.hud-sys-item[data-state="bad"]::before { background: var(--bad); box-shadow: 0 0 6px var(--bad); animation: hud-blink 0.9s infinite; }
+.hud-lang { font-family: var(--f-mono); font-size: 10.5px; color: var(--dim); background: transparent; border: 1px solid var(--hair); padding: 5px 6px; outline: 0; cursor: pointer; }
+.hud-lang:focus { border-color: var(--acc); }
+.hud-lang option { background: #050a12; color: var(--text); }
+
+/* ── toasts ───────────────────────────────────────────────────────────────── */
+.hud-toasts { position: fixed; top: 78px; left: var(--stage-x); transform: translateX(-50%); z-index: 40; display: flex; flex-direction: column; gap: 8px; align-items: center; pointer-events: none; transition: left 0.4s var(--ease); }
+.hud-toast {
+  display: flex; align-items: stretch; max-width: min(520px, 70vw); overflow: hidden;
+  background: rgba(4, 9, 16, 0.95); border: 1px solid var(--hair);
+  opacity: 0; transform: translateY(-8px); transition: opacity 0.3s, transform 0.3s var(--ease);
+}
+.hud-toast.show { opacity: 1; transform: none; }
+.hud-toast-bar { width: 3px; background: var(--acc); box-shadow: 0 0 8px var(--acc); }
+.hud-toast.warn .hud-toast-bar { background: var(--warn); box-shadow: 0 0 8px var(--warn); }
+.hud-toast-text { padding: 9px 14px; font-size: 12.5px; line-height: 1.45; color: var(--text); }
+
+/* ── top-right controls restyled; the old mute button lives on in the reactor ─ */
+#controls { top: 20px; right: 20px; z-index: 20; transition: right 0.4s var(--ease); }
+body.chat-open #controls { right: calc(min(var(--chat-w), 100vw) + 16px); }
+#controls button { width: 38px; height: 38px; border-radius: 2px; border: 1px solid var(--acc-line); background: rgba(4, 9, 16, 0.7); color: var(--dim); }
+#controls button:hover, #controls button.active { color: var(--acc); border-color: var(--acc); box-shadow: 0 0 14px var(--acc-soft); background: rgba(4, 9, 16, 0.9); }
+#btn-mute { display: none !important; }
+#menu-dropdown { right: 20px !important; top: 66px !important; border-radius: 2px !important; border: 1px solid var(--acc-line) !important; background: rgba(4, 9, 16, 0.95) !important; font-family: var(--f-ui); letter-spacing: 1px; }
+body.chat-open #menu-dropdown { right: calc(min(var(--chat-w), 100vw) + 16px) !important; }
+#status-text, #error-text, #jarvis-label, #mic-level, #hush { display: none !important; }
+
+@keyframes hud-spin { to { transform: rotate(360deg); } }
+@keyframes hud-blink { 50% { opacity: 0.35; } }
+@keyframes hud-breathe { 50% { opacity: 1; } }
+@keyframes hud-eq { from { --h: 0.15; transform: rotate(var(--a)) translateY(calc(-1 * (var(--size) / 2 + 13px))) scaleY(0.15); } to { transform: rotate(var(--a)) translateY(calc(-1 * (var(--size) / 2 + 13px))) scaleY(0.9); } }
+
+@media (max-width: 1199px) {
+  :root { --left-w: 0px; }
+  .hud-left, .hud-brand { display: none; }
+}
+@media (max-width: 760px) {
+  :root { --chat-w: 100vw; }
+  .hud-modes { min-width: 0; top: 70px; }
+  .hud-sys, .hud-bottom-label { display: none; }
+}
+@media (prefers-reduced-motion: reduce) {
+  .hud-ring-layer, .hud-reactor, .hud-reactor::before, .hud-reactor-bars, .hud-reactor-bars i { animation: none !important; }
+}
