+/* Conversations browser — same HUD language as the rest (tokens in hud.css). */
+.cv {
+  position: fixed; inset: 0; z-index: 50; display: flex; flex-direction: column; color: var(--text);
+  background: radial-gradient(ellipse at 30% 0%, var(--acc-soft), transparent 55%), rgba(2, 5, 10, 0.96);
+  contain: layout paint;
+  opacity: 0; transform: scale(0.99); transition: opacity 0.25s, transform 0.25s var(--ease);
+}
+.cv[hidden] { display: none; }
+.cv.show { opacity: 1; transform: none; }
+
+.cv-head { display: flex; align-items: center; gap: 14px; padding: 16px 24px; border-bottom: 1px solid var(--acc-line); }
+.cv-heading { min-width: 200px; }
+.cv-title { font-family: var(--f-ui); font-size: 19px; font-weight: 700; letter-spacing: 4px; text-transform: uppercase; }
+.cv-sub { font-family: var(--f-mono); font-size: 10px; color: var(--acc); margin-top: 1px; letter-spacing: 1px; }
+.cv-live { display: flex; align-items: center; gap: 8px; font-family: var(--f-mono); font-size: 10.5px; color: var(--dim); padding: 5px 10px; border: 1px solid var(--hair); white-space: nowrap; }
+.cv-live-dot { width: 6px; height: 6px; transform: rotate(45deg); background: var(--ok); box-shadow: 0 0 8px var(--ok); animation: hud-blink 1.6s infinite; }
+.cv-live-dot.off { background: var(--bad); box-shadow: none; animation: none; }
+.cv-search { flex: 1; max-width: 440px; margin-left: auto; font-family: var(--f-text); font-size: 13.5px; color: inherit; padding: 9px 14px; outline: 0; background: rgba(0, 0, 0, 0.35); border: 1px solid var(--acc-line); }
+.cv-search:focus { border-color: var(--acc); box-shadow: 0 0 0 3px var(--acc-soft); }
+.cv-close { width: 36px; height: 36px; cursor: pointer; color: var(--dim); background: transparent; border: 1px solid var(--hair); }
+.cv-close:hover { color: var(--acc); border-color: var(--acc); }
+.cv-transfer { padding: 10px 24px; font-family: var(--f-mono); font-size: 11.5px; line-height: 1.5; color: var(--text); background: var(--acc-soft); border-bottom: 1px solid var(--acc-line); }
+
+.cv-body { flex: 1; display: grid; grid-template-columns: 360px 1fr; min-height: 0; }
+.cv-list { overflow-y: auto; padding: 12px; border-right: 1px solid var(--hair); display: flex; flex-direction: column; gap: 4px; }
+.cv-item { text-align: left; font: inherit; color: inherit; cursor: pointer; padding: 10px 12px; background: transparent; border: 1px solid transparent; border-left: 2px solid transparent; transition: all 0.12s; }
+.cv-item:hover { background: rgba(255, 255, 255, 0.03); border-left-color: var(--acc-line); }
+.cv-item.active { background: var(--acc-soft); border-color: var(--acc-line); border-left-color: var(--acc); }
+.cv-item-top { display: flex; align-items: center; gap: 8px; }
+.cv-item-title { font-size: 13px; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.cv-item-meta { display: flex; align-items: center; gap: 8px; margin-top: 5px; font-family: var(--f-mono); font-size: 10px; color: var(--faint); }
+.cv-tag { padding: 1px 6px; color: var(--acc); border: 1px solid var(--acc-line); }
+.cv-pulse { flex: none; width: 6px; height: 6px; transform: rotate(45deg); background: var(--ok); box-shadow: 0 0 8px var(--ok); animation: hud-blink 1.4s infinite; }
+
+.cv-view { display: flex; flex-direction: column; min-width: 0; min-height: 0; }
+.cv-view-head { padding: 16px 28px 12px; border-bottom: 1px solid var(--hair); }
+.cv-view-title { font-family: var(--f-ui); font-size: 19px; font-weight: 700; letter-spacing: 0.5px; line-height: 1.3; }
+.cv-view-meta { font-family: var(--f-mono); font-size: 10.5px; color: var(--faint); margin-top: 4px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.cv-actions { display: flex; gap: 8px; margin-top: 12px; }
+.cv-btn { font-family: var(--f-ui); font-size: 12px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: var(--dim); cursor: pointer; padding: 7px 13px; background: transparent; border: 1px solid var(--acc-line); white-space: nowrap; }
+.cv-btn:hover { color: var(--acc); border-color: var(--acc); box-shadow: 0 0 12px var(--acc-soft); }
+.cv-btn-primary { color: #02070c; background: var(--acc); border-color: var(--acc); box-shadow: 0 0 16px var(--acc-glow); }
+.cv-btn-primary:hover { color: #02070c; filter: brightness(1.1); }
+
+.cv-msgs { flex: 1; overflow-y: auto; padding: 20px 28px 30px; display: flex; flex-direction: column; gap: 12px; }
+.cv-msg { display: flex; }
+.cv-msg.user { justify-content: flex-end; }
+.cv-bubble { max-width: min(780px, 88%); padding: 10px 14px; font-size: 13.5px; line-height: 1.6; overflow-wrap: anywhere; }
+.cv-msg.bot .cv-bubble { background: linear-gradient(90deg, var(--acc-soft), rgba(255, 255, 255, 0.02) 40%); border-left: 2px solid var(--acc); box-shadow: inset 0 0 0 1px var(--hair); }
+.cv-msg.user .cv-bubble { background: rgba(255, 255, 255, 0.045); border-right: 2px solid rgba(233, 245, 255, 0.55); box-shadow: inset 0 0 0 1px var(--hair); }
+.cv-bubble code { font-family: var(--f-mono); font-size: 12px; color: var(--acc-strong); background: rgba(0, 0, 0, 0.45); padding: 1px 5px; }
+.cv-bubble pre { margin: 8px 0 2px; padding: 10px 12px; background: rgba(0, 0, 0, 0.55); border: 1px solid var(--hair); overflow-x: auto; }
+.cv-bubble pre code { background: none; padding: 0; color: #d6ecff; }
+.cv-tools { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 8px; }
+.cv-tool { font-family: var(--f-mono); font-size: 10px; padding: 2px 7px; color: var(--acc); border: 1px solid var(--acc-line); }
+.cv-stamp { margin-top: 6px; font-family: var(--f-mono); font-size: 10px; color: var(--faint); text-align: right; }
+.cv-empty { margin: 40px auto; max-width: 360px; text-align: center; font-size: 13px; line-height: 1.6; color: var(--faint); }
+
+@media (max-width: 900px) { .cv-body { grid-template-columns: 1fr; } .cv-list { max-height: 34vh; border-right: 0; border-bottom: 1px solid var(--hair); } .cv-heading { display: none; } .cv-head { flex-wrap: wrap; } }
diff --git a/frontend/src/chats.ts b/frontend/src/chats.ts
