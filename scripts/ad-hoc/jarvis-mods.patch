+
+def _write(root: Path, sid: str, records: list[dict], project: str = "-home-u-proj") -> Path:
+    d = root / project
+    d.mkdir(parents=True)
+    p = d / f"{sid}.jsonl"
+    p.write_text("\n".join(json.dumps(r) for r in records) + "\n", encoding="utf-8")
+    return p
+
+
+def _u(text, **kw):
+    return {"type": "user", "timestamp": "2026-01-01T10:00:00Z", "cwd": "/home/u/proj",
+            "message": {"role": "user", "content": text}, **kw}
+
+
+def _a(content):
+    return {"type": "assistant", "timestamp": "2026-01-01T10:00:05Z", "cwd": "/home/u/proj",
+            "message": {"role": "assistant", "content": content}}
+
+
+def test_lists_conversations_with_title_project_and_count(tmp_path):
+    _write(tmp_path, SID, [
+        {"type": "ai-title", "aiTitle": "Refactor del login"},
+        _u("hola"), _a([{"type": "text", "text": "buenas"}]),
+    ])
+    rows = chats_view.list_chats(root=tmp_path)
+    assert len(rows) == 1
+    assert rows[0]["title"] == "Refactor del login"
+    assert rows[0]["project"] == "proj"
+    assert rows[0]["messages"] == 2
+
+
+def test_title_falls_back_to_first_prompt_and_skips_command_noise(tmp_path):
+    _write(tmp_path, SID, [_u("<command-name>/clear</command-name>"), _u("arregla el bug del pago")])
+    assert chats_view.list_chats(root=tmp_path)[0]["title"] == "arregla el bug del pago"
+
+
+def test_search_filters_by_title_and_project(tmp_path):
+    _write(tmp_path, SID, [_u("alpha task"), _a([{"type": "text", "text": "ok"}])])
+    assert chats_view.list_chats("alpha", root=tmp_path)
+    assert chats_view.list_chats("zzz", root=tmp_path) == []
+
+
+def test_read_returns_text_and_tool_names_but_not_tool_results(tmp_path):
+    _write(tmp_path, SID, [
+        _u("lista los archivos"),
+        _a([{"type": "text", "text": "voy"}, {"type": "tool_use", "name": "Bash", "input": {"command": "ls"}}]),
+        {"type": "user", "message": {"role": "user", "content": [{"type": "tool_result", "content": "SECRET-OUTPUT"}]}},
+        _a([{"type": "text", "text": "listo"}]),
+    ])
+    chat = chats_view.read_chat(SID, root=tmp_path)
+    assert chat["total"] == 3
+    assert chat["messages"][1]["tools"] == ["Bash"]
+    assert "SECRET-OUTPUT" not in json.dumps(chat)
+
+
+def test_read_after_returns_only_new_messages(tmp_path):
+    _write(tmp_path, SID, [_u("uno"), _a([{"type": "text", "text": "dos"}]), _u("tres")])
+    assert [m["text"] for m in chats_view.read_chat(SID, after=2, root=tmp_path)["messages"]] == ["tres"]
+
+
+def test_rejects_path_traversal_and_unknown_ids(tmp_path):
+    _write(tmp_path, SID, [_u("x"), _a([{"type": "text", "text": "y"}])])
+    assert chats_view.read_chat("../../etc/passwd", root=tmp_path) is None
+    assert chats_view.read_chat("aaaaaaaa-bbbb", root=tmp_path) is None
+    assert chats_view.read_chat(SID + "\n", root=tmp_path) is None   # a trailing newline must not pass
+
+
+def test_summary_cache_refreshes_when_file_grows(tmp_path):
+    p = _write(tmp_path, SID, [_u("uno"), _a([{"type": "text", "text": "dos"}])])
+    assert chats_view.list_chats(root=tmp_path)[0]["messages"] == 2
+    with p.open("a", encoding="utf-8") as fh:
+        fh.write(json.dumps(_u("tres")) + "\n")
+    assert chats_view.list_chats(root=tmp_path)[0]["messages"] == 3
