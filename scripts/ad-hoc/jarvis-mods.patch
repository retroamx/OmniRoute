+/**
+ * Command-centre HUD around the orb.
+ *
+ *   top      brand + clock · agent switch (Claude Code / Codex)
+ *   left     conversations · subscription gauges · Claude Code today · sessions · runs
+ *   centre   rotating rings around the orb · the "reactor" microphone control · live caption
+ *   bottom   live sessions · system status · voice language
+ *   anywhere quiet toasts instead of red error text
+ *
+ * Every number comes from the JARVIS REST API. When the voice brain has not measured the
+ * subscription yet, the Claude Code panel still shows real usage read from the CLI's own
+ * transcripts (/api/usage/sessions), and the sessions list falls back to recently active
+ * conversations (/api/chats) — so it is never empty just because one source is.
+ */
+
+import "./hud.css";
+import { VOICE_LANGS, getVoiceLang } from "./voice";
+import { el, svgIcon } from "./chat";
+
+interface LimitWindow { key: string; utilization: number | null; resets_at: number | null }
+interface SessionRow { session_id: string; project?: string; state?: string; cwd?: string; needs_a_human_hand?: boolean; title?: string | null; summary?: string | null }
+interface RunRow { status?: string; prompt?: string; project?: string }
+interface Tokens { input: number; output: number; cache_read: number; cache_creation: number; total: number }
+interface UsageScan {
+  measured?: boolean;
+  today?: Tokens;
+  session_count?: number;
+  project_count?: number;
+  daily?: { day: string; tokens: Tokens }[];
+  models?: { model: string; tokens: Tokens }[];
+}
+interface ChatRow { session_id: string; project: string; title: string; updated: number; messages: number }
+
+export interface AgentInfo { id: string; name: string; installed: boolean; logged_in: boolean; version: string; hint: string }
+export type TalkState = "muted" | "idle" | "listening" | "thinking" | "speaking" | "compacting";
+export type MicHealth = "ok" | "silent" | "blocked" | "unsupported";
+
+async function getJson<T>(url: string): Promise<T | null> {
+  try {
+    const r = await fetch(url);
+    return r.ok ? ((await r.json()) as T) : null;
+  } catch {
+    return null;
+  }
+}
+
+function fmtReset(epoch: number | null): string {
+  if (!epoch) return "";
+  const mins = Math.max(0, Math.round((epoch * 1000 - Date.now()) / 60000));
+  if (mins < 90) return `reinicio · ${mins} min`;
+  const h = Math.round(mins / 60);
+  return h < 48 ? `reinicio · ${h} h` : `reinicio · ${Math.round(h / 24)} d`;
+}
+
+export function fmtTokens(n: number): string {
+  if (n >= 1e9) return (n / 1e9).toFixed(1) + "B";
+  if (n >= 1e6) return (n / 1e6).toFixed(1) + "M";
+  if (n >= 1e3) return (n / 1e3).toFixed(1) + "k";
+  return String(n);
+}
+
+function ago(epochSec: number): string {
+  const s = Math.max(0, Math.round(Date.now() / 1000 - epochSec));
+  if (s < 60) return "ahora";
+  if (s < 3600) return `${Math.round(s / 60)} min`;
+  if (s < 86400) return `${Math.round(s / 3600)} h`;
+  return `${Math.round(s / 86400)} d`;
+}
+
+const SVGNS = "http://www.w3.org/2000/svg";
+function svg<K extends keyof SVGElementTagNameMap>(tag: K, attrs: Record<string, string | number>): SVGElementTagNameMap[K] {
+  const n = document.createElementNS(SVGNS, tag);
+  for (const [k, v] of Object.entries(attrs)) n.setAttribute(k, String(v));
+  return n;
+}
+
+/** A ring gauge: `value` 0..100 drawn as an arc. */
+function gauge(label: string): { root: HTMLElement; set(v: number | null, big: string, sub: string): void } {
+  const root = el("div", "hud-gauge");
+  const s = svg("svg", { viewBox: "0 0 100 100", class: "hud-gauge-svg" });
+  const r = 42;
+  const c = 2 * Math.PI * r;
+  s.append(
+    svg("circle", { cx: 50, cy: 50, r, class: "hud-gauge-track", "stroke-dasharray": `${c * 0.75} ${c}`, transform: "rotate(135 50 50)" }),
+  );
+  const arc = svg("circle", { cx: 50, cy: 50, r, class: "hud-gauge-arc", "stroke-dasharray": `0 ${c}`, transform: "rotate(135 50 50)" });
+  s.append(arc);
+  const big = el("div", "hud-gauge-big", "—");
+  const lab = el("div", "hud-gauge-label", label);
+  const sub = el("div", "hud-gauge-sub", "");
+  const mid = el("div", "hud-gauge-mid");
+  mid.append(big, lab);
+  root.append(s, mid, sub);
+  return {
+    root,
+    set(v, bigText, subText) {
+      const pct = v == null ? 0 : Math.max(0, Math.min(100, v));
+      arc.setAttribute("stroke-dasharray", `${(c * 0.75 * pct) / 100} ${c}`);
+      root.classList.toggle("hot", pct >= 85);
+      root.classList.toggle("empty", v == null);
+      big.textContent = bigText;
+      sub.textContent = subText;
+    },
+  };
+}
+
+export function createHud(opts: { onTalk(): void; onChats(): void; onLang(code: string): void; onAgent(id: string): void }) {
+  // ── top-left: brand + clock ──────────────────────────────────────────────
+  const brand = el("div", "hud-brand");
+  const word = el("div", "hud-word");
+  word.append("J.A.R.V.I.S", el("small", "", "v2"));
+  const tag = el("div", "hud-tag", "CENTRO DE MANDO");
+  const clock = el("div", "hud-clock");
+  const date = el("div", "hud-date");
+  brand.append(word, tag, clock, date);
+
+  // ── top-centre: agent switch ─────────────────────────────────────────────
+  const modes = el("div", "hud-modes");
+  const slider = el("span", "hud-mode-slider");
+  modes.append(slider);
+  const modeBtns: Record<string, HTMLButtonElement> = {};
+  for (const [id, label, sub] of [["claude", "CLAUDE CODE", "Anthropic"], ["codex", "CODEX", "OpenAI"]] as const) {
+    const b = el("button", "hud-mode");
+    b.type = "button";
+    b.dataset.id = id;
+    const txt = el("span", "hud-mode-txt");
+    txt.append(el("span", "hud-mode-name", label), el("span", "hud-mode-sub", sub));
+    b.append(el("span", "hud-mode-dot"), txt);
+    b.addEventListener("click", () => opts.onAgent(id));
+    modeBtns[id] = b;
+    modes.append(b);
+  }
+
+  // ── left column ──────────────────────────────────────────────────────────
+  const left = el("aside", "hud-left");
+  const chatsBtn = el("button", "hud-convos");
+  chatsBtn.type = "button";
+  const cIcon = el("span", "hud-convos-icon");
+  cIcon.append(svgIcon("M4 5h16v11H8l-4 4z", 1.6, 18));
+  const cTxt = el("span", "hud-convos-txt");
+  const cCount = el("span", "hud-convos-count", "—");
+  cTxt.append(el("span", "hud-convos-title", "Todas mis conversaciones"), el("span", "hud-convos-sub", "Historial de Claude Code · Ctrl+K"));
+  chatsBtn.append(cIcon, cTxt, cCount);
+  chatsBtn.addEventListener("click", opts.onChats);
+
+  const secSub = el("section", "hud-sec");
+  secSub.append(el("h3", "hud-h", "SUSCRIPCIÓN CLAUDE"));
+  const gauges = el("div", "hud-gauges");
+  const g5 = gauge("SESIÓN 5 H");
+  const g7 = gauge("SEMANA");
+  gauges.append(g5.root, g7.root);
+  const subNote = el("div", "hud-note");
+  secSub.append(gauges, subNote);
+
+  const secToday = el("section", "hud-sec");
+  secToday.append(el("h3", "hud-h", "CLAUDE CODE · HOY"));
+  const todayBig = el("div", "hud-big", "—");
+  const todayLab = el("div", "hud-big-label", "tokens procesados");
+  const todayStats = el("div", "hud-stats");
+  const spark = svg("svg", { viewBox: "0 0 100 24", preserveAspectRatio: "none", class: "hud-spark" });
+  const models = el("div", "hud-models");
+  secToday.append(todayBig, todayLab, todayStats, spark, models);
+
+  const secSess = el("section", "hud-sec");
+  const sessHead = el("h3", "hud-h", "SESIONES");
+  const sessList = el("div", "hud-list");
+  secSess.append(sessHead, sessList);
