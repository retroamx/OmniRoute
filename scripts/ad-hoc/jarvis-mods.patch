@@ -0,0 +1,56 @@
+.cv {
+  position: fixed; inset: 0; z-index: 50; display: flex; flex-direction: column;
+  background: rgba(4, 7, 12, 0.94); -webkit-backdrop-filter: blur(24px); backdrop-filter: blur(24px);
+  color: #e6f3ff; opacity: 0; transform: scale(0.985); transition: opacity 0.2s, transform 0.2s;
+}
+.cv[hidden] { display: none; }
+.cv.show { opacity: 1; transform: none; }
+
+.cv-head { display: flex; align-items: center; gap: 18px; padding: 16px 24px; border-bottom: 1px solid rgba(56, 189, 248, 0.16); }
+.cv-heading { min-width: 190px; }
+.cv-title { font-size: 17px; font-weight: 600; letter-spacing: 1.5px; }
+.cv-sub { font-size: 11.5px; color: rgba(190, 220, 245, 0.5); margin-top: 2px; }
+.cv-live { display: flex; align-items: center; gap: 8px; font-size: 11.5px; color: rgba(190, 220, 245, 0.6); padding: 5px 11px; border: 1px solid rgba(56, 189, 248, 0.16); border-radius: 999px; white-space: nowrap; }
+.cv-live-dot { width: 7px; height: 7px; border-radius: 50%; background: #34d399; box-shadow: 0 0 8px #34d399; animation: cv-pulse 1.6s infinite; }
+.cv-live-dot.off { background: #ef4444; box-shadow: none; animation: none; }
+.cv-search { flex: 1; max-width: 460px; margin-left: auto; font: inherit; font-size: 13.5px; color: inherit; padding: 9px 14px; border-radius: 10px; outline: 0; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(56, 189, 248, 0.16); }
+.cv-search:focus { border-color: rgba(56, 189, 248, 0.55); }
+.cv-close { width: 34px; height: 34px; border-radius: 9px; cursor: pointer; color: rgba(190, 220, 245, 0.7); background: rgba(56, 189, 248, 0.05); border: 1px solid rgba(56, 189, 248, 0.16); }
+.cv-close:hover { color: #fff; border-color: rgba(56, 189, 248, 0.5); }
+
+.cv-body { flex: 1; display: grid; grid-template-columns: 340px 1fr; min-height: 0; }
+.cv-list { overflow-y: auto; padding: 12px; border-right: 1px solid rgba(56, 189, 248, 0.12); display: flex; flex-direction: column; gap: 6px; }
+.cv-item { text-align: left; font: inherit; color: inherit; cursor: pointer; padding: 11px 13px; border-radius: 11px; background: transparent; border: 1px solid transparent; transition: all 0.12s; }
+.cv-item:hover { background: rgba(255, 255, 255, 0.04); }
+.cv-item.active { background: rgba(56, 189, 248, 0.11); border-color: rgba(56, 189, 248, 0.35); }
+.cv-item-top { display: flex; align-items: center; gap: 8px; }
+.cv-item-title { font-size: 13px; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.cv-item-meta { display: flex; align-items: center; gap: 8px; margin-top: 5px; font-size: 10.5px; color: rgba(190, 220, 245, 0.45); }
+.cv-tag { padding: 1px 7px; border-radius: 999px; background: rgba(56, 189, 248, 0.12); color: rgba(125, 211, 252, 0.9); }
+.cv-pulse { flex: none; width: 7px; height: 7px; border-radius: 50%; background: #34d399; box-shadow: 0 0 8px #34d399; animation: cv-pulse 1.4s infinite; }
+
+.cv-view { display: flex; flex-direction: column; min-width: 0; min-height: 0; }
