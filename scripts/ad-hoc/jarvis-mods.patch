             os.close(fd)
         return token
 
+    if not (hasattr(os, "O_NOFOLLOW") and hasattr(os, "getuid") and hasattr(os, "fchmod")):
+        # Windows has no O_NOFOLLOW, uid or fchmod, so the descriptor-based checks below cannot run
+        # (and used to crash JARVIS on its second start). The profile folder is already private to
+        # this user by its ACLs; keep the checks that do exist: a plain file, not a symlink.
+        if path.is_symlink() or not path.is_file():
+            raise OSError(f"{path} is not a regular file")
+        existing = path.read_text(encoding="utf-8", errors="ignore").strip()
+        if existing:
+            return existing
+        path.write_text(token, encoding="utf-8")
+        return token
