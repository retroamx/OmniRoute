+.hud-reactor[data-state="thinking"] .hud-reactor-bars i { --h: 0.35; background: var(--warn); }
+.hud-reactor[data-state="speaking"] { color: var(--ok); box-shadow: 0 0 0 6px rgba(2, 5, 10, 0.6), 0 0 0 7px rgba(62, 240, 176, 0.5), 0 0 40px rgba(62, 240, 176, 0.3); }
+.hud-reactor[data-state="speaking"] .hud-reactor-bars i { background: var(--ok); animation: hud-eq 0.7s ease-in-out infinite alternate; }
+.hud-reactor[data-state="speaking"] .hud-reactor-bars i:nth-child(3n) { animation-delay: 0.2s; }
+.hud-reactor[data-state="speaking"] .hud-reactor-bars i:nth-child(3n + 1) { animation-delay: 0.35s; }
+.hud-reactor[data-state="muted"], .hud-reactor[data-state="blocked"] { color: rgba(255, 90, 112, 0.9); border-color: rgba(255, 90, 112, 0.35); box-shadow: 0 0 0 6px rgba(2, 5, 10, 0.6), 0 0 0 7px rgba(255, 90, 112, 0.3); background: radial-gradient(circle at 50% 40%, rgba(255, 90, 112, 0.12), rgba(3, 8, 14, 0.92) 68%); }
+.hud-reactor[data-state="muted"] .hud-reactor-core::after { content: ""; position: absolute; width: 34px; height: 2px; background: currentColor; transform: rotate(-45deg); }
+.hud-reactor-label { font-family: var(--f-ui); font-size: 13px; font-weight: 700; letter-spacing: 4px; color: var(--text); margin-top: 8px; }
+.hud-reactor-wrap[data-state="hearing"] .hud-reactor-label { color: var(--acc-strong); text-shadow: 0 0 12px var(--acc-glow); }
+.hud-reactor-sub { font-family: var(--f-mono); font-size: 10px; color: var(--faint); min-height: 13px; letter-spacing: 0.5px; }
+.hud-heard {
+  max-width: min(560px, 48vw); margin-bottom: 14px; padding: 8px 16px; font-size: 14px; text-align: center; color: var(--dim);
+  background: rgba(3, 8, 14, 0.75); border: 1px solid var(--hair); border-left: 2px solid var(--acc);
+  opacity: 0; transform: translateY(6px); transition: opacity 0.25s, transform 0.25s; pointer-events: none;
+}
+.hud-heard::before { content: "› "; color: var(--acc); font-family: var(--f-mono); }
+.hud-heard.show { opacity: 1; transform: none; }
+.hud-heard.final { color: var(--text); }
+
+/* ── bottom bar ───────────────────────────────────────────────────────────── */
+.hud-bottom {
+  position: fixed; left: 0; right: 0; bottom: 0; height: 46px; z-index: 12; display: flex; align-items: center; gap: 14px; padding: 0 22px;
+  background: linear-gradient(0deg, rgba(2, 5, 10, 0.95), rgba(2, 5, 10, 0.7)); border-top: 1px solid var(--hair);
+  transition: right 0.4s var(--ease);
+}
+body.chat-open .hud-bottom { right: min(var(--chat-w), 100vw); }
+.hud-bottom-label { font-family: var(--f-ui); font-size: 10.5px; font-weight: 700; letter-spacing: 3px; color: var(--faint); }
+.hud-chips { flex: 1; display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; }
+.hud-chips::-webkit-scrollbar { height: 0; }
