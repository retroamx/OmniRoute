+/* ════════════════════════════════════════════════════════════════════════════
+   Chat panel — a transmission console on the right. Accent tokens come from hud.css.
+   ════════════════════════════════════════════════════════════════════════════ */
+
+.chat {
+  position: fixed; top: 0; right: 0; bottom: 0; width: min(var(--chat-w, 460px), 100vw); z-index: 30;
+  display: flex; flex-direction: column; color: var(--text);
+  background:
+    linear-gradient(180deg, hsl(var(--acc-h) 80% 50% / 0.06), transparent 30%),
+    linear-gradient(180deg, rgba(4, 9, 16, 0.95), rgba(2, 5, 10, 0.98));
+  /* No backdrop blur: the orb behind repaints every frame, so a blur would be recomputed every
+     frame too. The panel is near-opaque anyway. contain keeps chat reflows inside the panel. */
+  contain: layout paint; will-change: transform;
+  border-left: 1px solid var(--acc-line);
+  box-shadow: -30px 0 70px rgba(0, 0, 0, 0.6), inset 1px 0 0 hsl(var(--acc-h) 90% 70% / 0.08);
+  transform: translateX(102%); transition: transform 0.4s var(--ease), border-color 0.5s;
+}
+body.chat-open .chat { transform: none; }
+/* A thin glowing edge that runs down the panel's left side. */
+.chat::before {
+  content: ""; position: absolute; left: -1px; top: 0; width: 1px; height: 140px; will-change: transform;
+  background: linear-gradient(transparent, var(--acc), transparent); box-shadow: 0 0 10px var(--acc);
+  animation: chat-scan 6s linear infinite;
+}
+
+/* ── header ───────────────────────────────────────────────────────────────── */
+.chat-head { display: flex; align-items: center; gap: 12px; padding: 16px 18px 14px; border-bottom: 1px solid var(--hair); }
+.chat-emblem { position: relative; width: 38px; height: 38px; flex: none; display: grid; place-items: center; }
+.chat-emblem-core { width: 14px; height: 14px; transform: rotate(45deg); background: var(--acc); box-shadow: 0 0 16px var(--acc), 0 0 4px #fff inset; }
+.chat-emblem-ring { position: absolute; inset: 0; border: 1px solid var(--acc-line); border-top-color: var(--acc); border-radius: 50%; animation: hud-spin 3.5s linear infinite; }
+.chat-titles { flex: 1; min-width: 0; }
+.chat-title { font-family: var(--f-ui); font-size: 17px; font-weight: 700; letter-spacing: 5px; }
+.chat-sub { font-family: var(--f-mono); font-size: 9.5px; letter-spacing: 1px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--acc); opacity: 0.85; margin-top: 1px; }
+.chat-pill { display: flex; align-items: center; gap: 7px; padding: 5px 9px; border: 1px solid var(--hair); font-family: var(--f-ui); font-size: 10.5px; font-weight: 700; letter-spacing: 2px; color: var(--dim); white-space: nowrap; }
+.chat-pill-dot { width: 6px; height: 6px; transform: rotate(45deg); background: #56657a; }
+.chat-pill[data-state="listening"] .chat-pill-dot { background: var(--ok); box-shadow: 0 0 8px var(--ok); }
+.chat-pill[data-state="thinking"] .chat-pill-dot, .chat-pill[data-state="compacting"] .chat-pill-dot { background: var(--warn); animation: hud-blink 0.8s infinite; }
+.chat-pill[data-state="speaking"] .chat-pill-dot { background: var(--acc); box-shadow: 0 0 8px var(--acc); animation: hud-blink 0.6s infinite; }
+.chat-btn { display: inline-flex; align-items: center; gap: 6px; height: 30px; min-width: 30px; justify-content: center; padding: 0 8px; border: 1px solid var(--hair); background: transparent; color: var(--dim); font-family: var(--f-ui); font-size: 10.5px; font-weight: 700; letter-spacing: 2px; cursor: pointer; transition: all 0.15s; }
+.chat-btn:hover { color: var(--acc); border-color: var(--acc); }
+.chat-stop { color: var(--warn); border-color: rgba(255, 194, 75, 0.45); }
+.chat-stop[hidden] { display: none; }
+
+/* ── core status ──────────────────────────────────────────────────────────── */
+.chat-core { display: flex; align-items: center; gap: 9px; padding: 7px 18px; font-family: var(--f-ui); font-size: 10.5px; font-weight: 700; letter-spacing: 2.5px; color: var(--dim); border-bottom: 1px solid var(--hair); }
+.chat-core-dot { width: 6px; height: 6px; transform: rotate(45deg); background: #56657a; }
+.chat-core[data-state="ready"] .chat-core-dot { background: var(--ok); box-shadow: 0 0 8px var(--ok); }
+.chat-core[data-state="starting"] .chat-core-dot, .chat-core[data-state="disconnected"] .chat-core-dot { background: var(--warn); animation: hud-blink 1s infinite; }
+.chat-core[data-state="failed"], .chat-core[data-state="offline"] { color: #ffb3bf; background: rgba(255, 90, 112, 0.06); }
+.chat-core[data-state="failed"] .chat-core-dot, .chat-core[data-state="offline"] .chat-core-dot { background: var(--bad); box-shadow: 0 0 8px var(--bad); animation: hud-blink 0.8s infinite; }
+.chat-core-text { flex: 1; }
