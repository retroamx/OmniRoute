+/**
+ * Chat panel — type to JARVIS (Claude Code) or Codex and read the replies as a conversation.
+ *
+ * Voice-brain replies are rebuilt from the `audio` / `text` frames of the voice WebSocket (each
+ * carries the sentence it voices); Codex replies arrive whole through `botMessage`. The history
+ * is kept in this browser (localStorage) so a reload, or a restart of JARVIS, does not wipe it,
+ * and it travels with the conversation export.
+ *
+ * Everything model-written is rendered with DOM text nodes only — never innerHTML.
+ */
+
+import "./chat.css";
+
+export type ChatState = "idle" | "listening" | "thinking" | "speaking" | "compacting";
+export type CoreState = "ready" | "starting" | "failed" | "offline" | "disconnected";
+
+export interface ChatOptions {
+  onSend(text: string): void;
+  onStop(): void;
+  onRetryCore(): void;
+}
+
+export interface StoredMsg {
+  role: "user" | "bot" | "note";
+  text: string;
+  agent: string;
+  t: number;
+  kind?: "info" | "error";
+  voice?: boolean;
+}
+
+export interface Chat {
+  addUser(text: string, viaVoice?: boolean): void;
+  handleMessage(msg: Record<string, unknown>): void;
+  setState(state: ChatState): void;
+  toggle(force?: boolean): void;
+  ask(text: string): void;
+  setAgent(id: string, name: string): void;
+  botMessage(text: string): void;
+  botNote(text: string, kind?: "info" | "error"): void;
+  setTyping(on: boolean): void;
+  setCore(state: CoreState, detail?: string | null): void;
+  history(): StoredMsg[];
+  mergeHistory(items: StoredMsg[]): number;
+}
+
+const HISTORY_KEY = "jarvis.chat.history.v1";
+const HISTORY_MAX = 300;
+const RESTORE_MAX = 60;
+
+const SKILLS: Record<string, { title: string; hint: string; prompt: string; icon: string }[]> = {
+  claude: [
+    { title: "Planear el día", hint: "prioridades", icon: "M4 7h16M4 12h10M4 17h7", prompt: "Ayúdame a planear mi día: pregúntame lo que necesites y propón un orden de prioridades." },
+    { title: "Mis sesiones", hint: "qué me espera", icon: "M4 5h16v10H4zM8 19h8", prompt: "¿Qué sesiones de Claude Code tengo abiertas y cuáles esperan algo de mí?" },
+    { title: "Investigar", hint: "buscar y resumir", icon: "M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14zM21 21l-5-5", prompt: "Quiero investigar un tema a fondo. Pregúntame cuál y prepara un resumen con fuentes." },
+    { title: "Nuevo proyecto", hint: "diseñar y construir", icon: "M12 3l9 5-9 5-9-5 9-5zM3 13l9 5 9-5", prompt: "Quiero empezar un proyecto nuevo. Ayúdame a diseñarlo paso a paso, con una pregunta cada vez." },
+  ],
+  codex: [
+    { title: "Explicar código", hint: "qué hace y por qué", icon: "M8 7l-5 5 5 5M16 7l5 5-5 5", prompt: "Explícame el código de la carpeta actual: estructura, piezas clave y cómo encajan." },
+    { title: "Buscar errores", hint: "revisión rápida", icon: "M12 9v4M12 17h.01M10.3 3.9L1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z", prompt: "Revisa el código de la carpeta actual y dime los fallos más probables, ordenados por gravedad." },
+    { title: "Escribir tests", hint: "qué falta probar", icon: "M9 12l2 2 4-4M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z", prompt: "¿Qué partes del código de la carpeta actual necesitan tests? Propón los más importantes." },
+    { title: "Resumen del repo", hint: "en 5 líneas", icon: "M4 6h16M4 10h16M4 14h10M4 18h6", prompt: "Resume en 5 líneas qué es el proyecto de la carpeta actual y cómo se ejecuta." },
+  ],
+};
+
+const STATE_LABEL: Record<ChatState, string> = {
+  idle: "EN ESPERA",
+  listening: "ESCUCHANDO",
+  thinking: "PROCESANDO",
+  speaking: "HABLANDO",
+  compacting: "REORGANIZANDO",
+};
+
+const CORE_LABEL: Record<CoreState, string> = {
+  ready: "NÚCLEO EN LÍNEA",
+  starting: "NÚCLEO INICIANDO",
+  failed: "NÚCLEO CAÍDO",
+  offline: "SERVIDOR SIN RESPUESTA",
+  disconnected: "RECONECTANDO",
+};
+
+export function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string): HTMLElementTagNameMap[K] {
+  const node = document.createElement(tag);
+  if (cls) node.className = cls;
+  if (text !== undefined) node.textContent = text;
+  return node;
+}
+
+/** A tiny markdown subset (```blocks```, `code`, **bold**, line breaks) rendered with DOM nodes only. */
+export function renderRich(target: HTMLElement, raw: string): void {
+  target.replaceChildren();
+  raw.split(/```/).forEach((part, i) => {
+    if (i % 2 === 1) {
+      const pre = el("pre");
+      pre.append(el("code", "", part.replace(/^[a-z0-9_-]*\n/i, "").trim()));
+      target.append(pre);
+      return;
+    }
+    part.split("\n").forEach((line, li) => {
+      if (li > 0) target.append(document.createElement("br"));
+      line.split(/(`[^`\n]+`|\*\*[^*\n]+\*\*)/).forEach((tok) => {
+        if (!tok) return;
+        if (tok.startsWith("`") && tok.endsWith("`") && tok.length > 2) target.append(el("code", "", tok.slice(1, -1)));
+        else if (tok.startsWith("**") && tok.endsWith("**") && tok.length > 4) target.append(el("strong", "", tok.slice(2, -2)));
+        else target.append(document.createTextNode(tok));
+      });
+    });
+  });
+}
+
+export function svgIcon(path: string, width = 1.6, size = 18): SVGSVGElement {
+  const ns = "http://www.w3.org/2000/svg";
+  const svg = document.createElementNS(ns, "svg");
+  svg.setAttribute("width", String(size));
+  svg.setAttribute("height", String(size));
+  svg.setAttribute("viewBox", "0 0 24 24");
+  svg.setAttribute("fill", "none");
+  svg.setAttribute("stroke", "currentColor");
+  svg.setAttribute("stroke-width", String(width));
+  svg.setAttribute("stroke-linecap", "round");
+  svg.setAttribute("stroke-linejoin", "round");
+  const p = document.createElementNS(ns, "path");
+  p.setAttribute("d", path);
+  svg.append(p);
+  return svg;
+}
+
+function hhmm(t = Date.now()): string {
+  return new Date(t).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
+}
+
+function loadHistory(): StoredMsg[] {
+  try {
+    const raw = localStorage.getItem(HISTORY_KEY);
+    const parsed = raw ? JSON.parse(raw) : [];
+    return Array.isArray(parsed) ? parsed.filter(isStoredMsg).slice(-HISTORY_MAX) : [];
+  } catch {
+    return [];
+  }
+}
+
+function isStoredMsg(m: unknown): m is StoredMsg {
+  const o = m as StoredMsg;
+  return !!o && typeof o === "object" && (o.role === "user" || o.role === "bot" || o.role === "note")
+    && typeof o.text === "string" && typeof o.t === "number" && typeof o.agent === "string";
+}
+
+export function createChat(opts: ChatOptions): Chat {
+  const panel = el("aside", "chat");
+  panel.id = "chat";
+  panel.setAttribute("aria-label", "Conversación con JARVIS");
+
+  // ── header ────────────────────────────────────────────────────────────────
+  const header = el("header", "chat-head");
+  const emblem = el("div", "chat-emblem");
+  emblem.append(el("span", "chat-emblem-core"), el("span", "chat-emblem-ring"));
+  const titles = el("div", "chat-titles");
+  const nameEl = el("div", "chat-title", "JARVIS");
+  const subEl = el("div", "chat-sub", "CANAL · CLAUDE CODE");
+  titles.append(nameEl, subEl);
+  const pill = el("div", "chat-pill");
+  pill.append(el("span", "chat-pill-dot"), el("span", "chat-pill-text", STATE_LABEL.idle));
+  const pillText = pill.lastChild as HTMLElement;
+  const stopBtn = el("button", "chat-btn chat-stop");
+  stopBtn.type = "button";
+  stopBtn.hidden = true;
+  stopBtn.title = "Silenciar a JARVIS (Esc)";
+  stopBtn.append(svgIcon("M6 6h12v12H6z", 1.8, 14), el("span", "", "DETENER"));
+  const closeBtn = el("button", "chat-btn chat-close");
+  closeBtn.type = "button";
+  closeBtn.title = "Cerrar panel (Ctrl+/)";
+  closeBtn.append(svgIcon("M6 6l12 12M18 6L6 18", 1.8, 14));
+  header.append(emblem, titles, pill, stopBtn, closeBtn);
+
+  // Core (voice brain) status strip: says why JARVIS is not answering instead of staying silent.
+  const core = el("div", "chat-core");
+  core.dataset.state = "starting";
+  const coreDot = el("span", "chat-core-dot");
+  const coreText = el("span", "chat-core-text", CORE_LABEL.starting);
+  const coreRetry = el("button", "chat-core-retry", "REINTENTAR");
+  coreRetry.type = "button";
+  coreRetry.hidden = true;
+  coreRetry.addEventListener("click", () => opts.onRetryCore());
+  core.append(coreDot, coreText, coreRetry);
+  const coreDetail = el("div", "chat-core-detail");
+  coreDetail.hidden = true;
+
+  // Codex mode banner.
+  const banner = el("div", "chat-banner");
+  banner.append(el("span", "chat-banner-tag", "MODO CODEX"), el("span", "chat-banner-text", "OpenAI · solo lectura · tu carpeta personal"));
+
+  // ── quick actions ─────────────────────────────────────────────────────────
+  const skills = el("section", "chat-skills");
+  const grid = el("div", "chat-skills-grid");
+  skills.append(grid);
+
+  // ── message list ──────────────────────────────────────────────────────────
+  const list = el("div", "chat-list");
+  list.setAttribute("role", "log");
+  list.setAttribute("aria-live", "polite");
+  const empty = el("div", "chat-empty");
+  const emptyTitle = el("div", "chat-empty-title", "Canal abierto");
+  const emptySub = el("div", "chat-empty-sub", "Escribe o habla. JARVIS planea, construye y vigila tus sesiones de Claude Code.");
+  empty.append(el("div", "chat-empty-glyph"), emptyTitle, emptySub);
+  list.append(empty);
+
+  // ── composer ──────────────────────────────────────────────────────────────
+  const composer = el("form", "chat-composer");
+  const prompt = el("span", "chat-prompt", "›");
+  const input = el("textarea", "chat-input");
+  input.rows = 1;
+  input.placeholder = "Transmitir mensaje a JARVIS…";
+  input.setAttribute("aria-label", "Mensaje");
+  const sendBtn = el("button", "chat-send");
+  sendBtn.type = "submit";
+  sendBtn.title = "Enviar (Enter)";
+  sendBtn.append(svgIcon("M5 12h14M13 6l6 6-6 6", 2, 18));
+  composer.append(prompt, input, sendBtn);
+  const foot = el("div", "chat-foot");
+  foot.append(el("span", "", "ENTER envía"), el("span", "", "SHIFT+ENTER salto"), el("span", "", "ESC silencia"));
+
+  panel.append(header, core, coreDetail, banner, skills, list, composer, foot);
+  document.body.appendChild(panel);
+
+  // Launcher in the top-right controls.
+  const launcher = el("button");
+  launcher.id = "btn-chat";
+  launcher.type = "button";
+  launcher.title = "Chat (Ctrl+/)";
+  launcher.append(svgIcon("M21 12a8 8 0 0 1-11.5 7.2L4 20l1-4.6A8 8 0 1 1 21 12z", 1.5));
+  document.getElementById("controls")?.prepend(launcher);
+
+  // ── state ─────────────────────────────────────────────────────────────────
+  let open = false;
+  let agent = "claude";
+  let typingRow: HTMLElement | null = null;
+  let replyBody: HTMLElement | null = null;
+  let replyIdx = -1;             // index in `store` of the reply being assembled
+  let replyUtt: number | null = null;
+  const seen = new Set<string>();
+  const store: StoredMsg[] = loadHistory();
+  let saveTimer = 0;
+
+  function save() {
+    clearTimeout(saveTimer);
+    saveTimer = window.setTimeout(() => {
+      try {
+        localStorage.setItem(HISTORY_KEY, JSON.stringify(store.slice(-HISTORY_MAX)));
+      } catch { /* full or blocked: the panel still works */ }
+    }, 300);
+  }
+
+  function remember(m: StoredMsg): number {
+    store.push(m);
+    if (store.length > HISTORY_MAX * 1.2) store.splice(0, store.length - HISTORY_MAX);
+    save();
+    return store.length - 1;
+  }
+
+  // Coalesced to one layout read per frame: a streamed reply calls this for every chunk.
+  let scrollQueued = false;
+  function scrollDown() {
+    if (scrollQueued) return;
+    scrollQueued = true;
+    requestAnimationFrame(() => {
+      scrollQueued = false;
+      list.scrollTop = list.scrollHeight;
+    });
+  }
+
+  function dropEmpty() {
+    if (empty.parentElement) empty.remove();
+  }
+
+  function renderSkills() {
+    grid.replaceChildren();
+    for (const sk of SKILLS[agent] ?? SKILLS.claude) {
+      const card = el("button", "chat-skill");
+      card.type = "button";
+      const ic = el("span", "chat-skill-icon");
+      ic.append(svgIcon(sk.icon, 1.6, 16));
+      const txt = el("span", "chat-skill-txt");
+      txt.append(el("span", "chat-skill-title", sk.title), el("span", "chat-skill-hint", sk.hint));
+      card.append(ic, txt);
+      card.addEventListener("click", () => send(sk.prompt));
+      grid.append(card);
+    }
+  }
+
+  function showTyping(on: boolean) {
+    if (on && !typingRow) {
+      typingRow = el("div", "msg msg-bot msg-typing");
+      const bubble = el("div", "bubble");
+      bubble.append(el("span", "typing-label", agent === "codex" ? "CODEX PROCESANDO" : "JARVIS PROCESANDO"), el("span", "typing-bar"));
+      typingRow.append(bubble);
+      dropEmpty();
+      list.append(typingRow);
+      scrollDown();
+    } else if (!on && typingRow) {
+      typingRow.remove();
+      typingRow = null;
+    }
+  }
+
+  function tagFor(a: string): string {
+    return a === "codex" ? "CODEX" : "JARVIS";
+  }
+
+  function drawUser(text: string, t: number, voice: boolean): void {
+    const row = el("div", "msg msg-user");
+    const bubble = el("div", "bubble");
+    const meta = el("div", "msg-meta");
+    meta.append(el("span", "msg-who", voice ? "TÚ · VOZ" : "TÚ"), el("span", "msg-time", hhmm(t)));
+    const body = el("div", "bubble-body");
+    renderRich(body, text);
+    bubble.append(meta, body);
+    row.append(bubble);
+    list.append(row);
+  }
+
+  function drawBot(text: string, t: number, a: string): HTMLElement {
+    const row = el("div", "msg msg-bot");
+    row.dataset.agent = a;
+    const bubble = el("div", "bubble");
+    const meta = el("div", "msg-meta");
+    meta.append(el("span", "msg-who", tagFor(a)), el("span", "msg-time", hhmm(t)));
+    const body = el("div", "bubble-body");
+    renderRich(body, text);
+    bubble.append(meta, body);
+    row.append(bubble);
+    list.append(row);
+    return body;
+  }
+
+  function drawNote(text: string, kind: "info" | "error"): void {
+    const note = el("div", "msg-note" + (kind === "error" ? " error" : ""));
+    renderRich(note, text);
+    list.append(note);
+  }
+
+  function appendBot(text: string, utt: number | null) {
+    const clean = text.trim();
+    if (!clean) return;
+    showTyping(false);
+    dropEmpty();
+    if (!replyBody || (utt !== null && replyUtt !== null && utt !== replyUtt)) {
+      const t = Date.now();
+      replyBody = drawBot(clean, t, "claude");
+      replyIdx = remember({ role: "bot", text: clean, agent: "claude", t });
+    } else {
+      const m = store[replyIdx];
+      if (m) {
+        m.text += " " + clean;
+        renderRich(replyBody, m.text);
+        save();
+      }
+    }
+    replyUtt = utt;
+    scrollDown();
+  }
+
+  function addUser(text: string, viaVoice = false) {
+    const clean = text.trim();
+    if (!clean) return;
+    dropEmpty();
+    const t = Date.now();
+    drawUser(clean, t, viaVoice);
+    remember({ role: "user", text: clean, agent, t, voice: viaVoice || undefined });
+    replyBody = null;
+    replyUtt = null;
+    scrollDown();
+  }
+
+  function send(text: string) {
+    const clean = text.trim();
+    if (!clean) return;
+    addUser(clean);
+    opts.onSend(clean);
+    showTyping(true);
+    input.value = "";
+    autosize();
+    input.focus();
+  }
+
+  function autosize() {
+    input.style.height = "auto";
+    input.style.height = Math.min(input.scrollHeight, 160) + "px";
+  }
+
+  function renderStored() {
+    if (!store.length) return;
+    dropEmpty();
+    // Only the recent part is drawn on load (the rest stays saved), without the entry
+    // animation: hundreds of bubbles animating at once is what made opening the page stutter.
+    list.classList.add("restoring");
+    for (const m of store.slice(-RESTORE_MAX)) {
+      if (m.role === "user") drawUser(m.text, m.t, !!m.voice);
+      else if (m.role === "bot") drawBot(m.text, m.t, m.agent);
+      else drawNote(m.text, m.kind ?? "info");
+    }
+    const div = el("div", "msg-divider");
+    div.append(el("span", "", `SESIÓN ANTERIOR · ${new Date(store[store.length - 1].t).toLocaleDateString()}`));
+    list.append(div);
+    scrollDown();
+    setTimeout(() => list.classList.remove("restoring"), 400);
+  }
+
+  composer.addEventListener("submit", (e) => {
+    e.preventDefault();
+    send(input.value);
+  });
+  input.addEventListener("input", autosize);
+  input.addEventListener("keydown", (e: KeyboardEvent) => {
+    if (e.key === "Enter" && !e.shiftKey && !e.isComposing) {
+      e.preventDefault();
+      send(input.value);
+    }
+    e.stopPropagation();
+    if (e.key === "Escape") opts.onStop();
+  });
+  stopBtn.addEventListener("click", () => opts.onStop());
+  closeBtn.addEventListener("click", () => toggle(false));
+  launcher.addEventListener("click", (e) => {
+    e.stopPropagation();
+    toggle();
+  });
+  window.addEventListener("keydown", (e: KeyboardEvent) => {
+    if ((e.ctrlKey || e.metaKey) && e.key === "/") {
+      e.preventDefault();
+      toggle();
+    }
+  });
+
+  function toggle(force?: boolean) {
+    open = force ?? !open;
+    document.body.classList.toggle("chat-open", open);
+    launcher.classList.toggle("active", open);
+    try { localStorage.setItem("jarvis.chat.open", open ? "1" : "0"); } catch { /* ignore */ }
+    window.dispatchEvent(new CustomEvent("jarvis:layout"));
+    if (open) setTimeout(() => input.focus(), 250);
+  }
+
+  function setState(next: ChatState) {
+    pillText.textContent = STATE_LABEL[next];
+    pill.dataset.state = next;
+    stopBtn.hidden = next !== "speaking";
+    if (agent !== "claude") return;
+    if (next === "thinking") showTyping(true);
+    else if (next !== "compacting") showTyping(false);
+  }
+
+  function handleMessage(msg: Record<string, unknown>) {
+    const type = msg.type as string;
+    if (type === "audio" && msg.text) {
+      const utt = Number(msg.utt);
+      const key = `${utt}:${msg.idx}`;
+      if (seen.has(key)) return;
+      seen.add(key);
+      appendBot(String(msg.text), Number.isFinite(utt) ? utt : null);
+    } else if (type === "text" && msg.text) {
+      appendBot(String(msg.text), null);
+    }
+  }
+
+  function botMessage(text: string) {
+    const clean = text.trim();
+    if (!clean) return;
+    showTyping(false);
+    dropEmpty();
+    replyBody = null;
+    replyUtt = null;
+    const t = Date.now();
+    drawBot(clean, t, agent);
+    remember({ role: "bot", text: clean, agent, t });
+    scrollDown();
+  }
+
+  function botNote(text: string, kind: "info" | "error" = "info") {
+    showTyping(false);
+    dropEmpty();
+    drawNote(text, kind);
+    remember({ role: "note", text, agent, t: Date.now(), kind });
+    scrollDown();
+  }
+
+  function setCore(state: CoreState, detail?: string | null) {
+    core.dataset.state = state;
+    coreText.textContent = CORE_LABEL[state];
+    coreRetry.hidden = state !== "failed";
+    const d = (detail ?? "").trim();
+    coreDetail.hidden = !(d && (state === "failed" || state === "offline"));
+    coreDetail.textContent = d;
+    if (agent === "claude" && (state === "failed" || state === "offline" || state === "disconnected")) showTyping(false);
+  }
+
+  function setAgent(id: string, name: string) {
+    agent = id;
+    document.body.dataset.agent = id;
+    nameEl.textContent = id === "codex" ? "CODEX" : "JARVIS";
+    subEl.textContent = `CANAL · ${name.toUpperCase()}`;
+    input.placeholder = id === "codex" ? "Pide algo a Codex…" : "Transmitir mensaje a JARVIS…";
+    emptyTitle.textContent = id === "codex" ? "Codex listo" : "Canal abierto";
+    emptySub.textContent = id === "codex"
+      ? "Codex lee tu código y responde por escrito. Trabaja en modo solo lectura."
+      : "Escribe o habla. JARVIS planea, construye y vigila tus sesiones de Claude Code.";
+    renderSkills();
+  }
+
+  let remembered = false;
+  try { remembered = localStorage.getItem("jarvis.chat.open") === "1"; } catch { /* ignore */ }
+  renderSkills();
+  renderStored();
+  toggle(remembered || window.innerWidth >= 1000);
+
+  return {
+    botMessage, botNote, setTyping: showTyping, setCore, setAgent,
+    addUser, handleMessage, setState, toggle,
+    ask(text: string) { toggle(true); send(text); },
+    history: () => store.slice(-HISTORY_MAX),
+    mergeHistory(items: StoredMsg[]) {
+      const have = new Set(store.map((m) => `${m.t}:${m.role}:${m.text.slice(0, 40)}`));
+      const fresh = items.filter(isStoredMsg).filter((m) => !have.has(`${m.t}:${m.role}:${m.text.slice(0, 40)}`));
+      if (!fresh.length) return 0;
+      store.push(...fresh);
+      store.sort((a, b) => a.t - b.t);
+      save();
+      list.replaceChildren();
+      renderStored();
+      return fresh.length;
+    },
+  };
+}
