+.hud-reactor[data-state="hearing"] { color: #fff; background: radial-gradient(circle at 50% 40%, hsl(var(--acc-h) 100% 60% / 0.55), rgba(3, 8, 14, 0.9) 70%); box-shadow: 0 0 0 6px rgba(2, 5, 10, 0.6), 0 0 0 7px var(--acc), 0 0 60px var(--acc-glow), inset 0 0 30px var(--acc-glow); }
+.hud-reactor[data-state="thinking"], .hud-reactor[data-state="compacting"] { color: var(--warn); box-shadow: 0 0 0 6px rgba(2, 5, 10, 0.6), 0 0 0 7px rgba(255, 194, 75, 0.45), 0 0 34px rgba(255, 194, 75, 0.25); }
