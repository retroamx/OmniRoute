+import io
+import json
+import sys
+import zipfile
+from pathlib import Path
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).parent.parent))
+
+import transfer
+
+
+def _setup(tmp_path):
+    projects = tmp_path / "a" / "projects"
+    (projects / "-home-u-proj").mkdir(parents=True)
+    (projects / "-home-u-proj" / "s1.jsonl").write_text('{"type":"user"}\n')
+    brain = tmp_path / "a" / "jarvis"
+    (brain / "memory").mkdir(parents=True)
+    (brain / "MEMORY.md").write_text("- [fact](fact.md)\n")
+    (brain / "memory" / "fact.md").write_text("a fact")
+    (brain / "tool-token").write_text("SECRET-TOKEN")
+    (brain / "connections.json").write_text('{"token": "SECRET"}')
+    return projects, brain
+
+
+def test_round_trip_moves_conversations_memory_and_chat(tmp_path):
+    projects, brain = _setup(tmp_path)
+    blob, counts = transfer.export_zip([{"role": "user", "text": "hola", "agent": "claude", "t": 1}], projects, brain)
+    assert counts["conversations"] == 1 and counts["memory_files"] == 2 and counts["chat_messages"] == 1
+    assert b"SECRET" not in blob                                     # no tokens, no connections.json
+    dst_p, dst_b = tmp_path / "b" / "projects", tmp_path / "b" / "jarvis"
+    r = transfer.import_zip(blob, dst_p, dst_b)
+    assert r["conversations"] == 1 and r["memory_files"] == 2
+    assert (dst_p / "-home-u-proj" / "s1.jsonl").read_text() == '{"type":"user"}\n'
+    assert (dst_b / "memory" / "fact.md").read_text() == "a fact"
+    assert r["chat_history"][0]["text"] == "hola"
+
+
+def test_import_never_overwrites_except_a_longer_transcript(tmp_path):
+    projects, brain = _setup(tmp_path)
+    blob, _ = transfer.export_zip(None, projects, brain)
+    dst_p, dst_b = tmp_path / "b" / "projects", tmp_path / "b" / "jarvis"
+    (dst_p / "-home-u-proj").mkdir(parents=True)
+    (dst_p / "-home-u-proj" / "s1.jsonl").write_text('{"type":"user"}\n{"more":1}\n')   # already longer here
+    (dst_b / "memory").mkdir(parents=True)
+    (dst_b / "memory" / "fact.md").write_text("my own edit")
+    r = transfer.import_zip(blob, dst_p, dst_b)
+    assert (dst_p / "-home-u-proj" / "s1.jsonl").read_text().count("\n") == 2
+    assert (dst_b / "memory" / "fact.md").read_text() == "my own edit"
+    assert r["conversations"] == 0 and r["updated"] == 0
+
+
+def _evil_zip(entries: dict) -> bytes:
+    buf = io.BytesIO()
+    with zipfile.ZipFile(buf, "w") as z:
+        z.writestr("manifest.json", json.dumps({"format": transfer.FORMAT}))
+        for name, data in entries.items():
+            z.writestr(name, data)
+    return buf.getvalue()
+
+
+@pytest.mark.parametrize("name", [
+    "claude/projects/../../escape.jsonl",
+    "claude/projects/x/../../../escape.jsonl",
+    "/etc/passwd",
+    "claude/projects/x/s.txt",
+    "jarvis/memory/../../../escape.md",
+    "jarvis/tool-token",
+    "jarvis/connections.json",
+    "anything/else",
+])
+def test_import_rejects_anything_outside_the_allowed_shapes(tmp_path, name):
+    dst_p, dst_b = tmp_path / "b" / "projects", tmp_path / "b" / "jarvis"
+    r = transfer.import_zip(_evil_zip({name: "x"}), dst_p, dst_b)
+    assert r["conversations"] == 0 and r["memory_files"] == 0 and r["skipped"] == 1
+    written = [p for p in tmp_path.rglob("*") if p.is_file()]
+    assert written == []
+
+
+def test_import_rejects_symlink_entries(tmp_path):
+    buf = io.BytesIO()
+    with zipfile.ZipFile(buf, "w") as z:
+        z.writestr("manifest.json", json.dumps({"format": transfer.FORMAT}))
+        info = zipfile.ZipInfo("claude/projects/x/s.jsonl")
+        info.external_attr = (0o120777 << 16)
+        z.writestr(info, "/etc/passwd")
+    r = transfer.import_zip(buf.getvalue(), tmp_path / "p", tmp_path / "j")
+    assert r["skipped"] == 1 and not (tmp_path / "p").exists()
+
+
+def test_import_rejects_non_jarvis_files():
+    with pytest.raises(ValueError):
+        transfer.import_zip(b"not a zip")
+    buf = io.BytesIO()
+    with zipfile.ZipFile(buf, "w") as z:
+        z.writestr("hello.txt", "x")
+    with pytest.raises(ValueError):
+        transfer.import_zip(buf.getvalue())
