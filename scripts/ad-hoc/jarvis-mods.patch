+++ b/chats_view.py
@@ -0,0 +1,178 @@
+"""
+chats_view.py — read-only view over Claude Code's own conversation history.
+
+Claude Code keeps every conversation as a JSONL file under
+``<config dir>/projects/<encoded cwd>/<session id>.jsonl``. This module lists
+them and reads one back as plain messages, so the UI can show *all* of the
+user's chats (not only the live ones) and keep them current.
+
+Pure file reading: no subprocess, no writes, no network, no new dependency.
+Everything here is data from a transcript, never instructions.
+"""
+from __future__ import annotations
+
+import json
+import os
+import re
+from pathlib import Path
+from typing import Any, Optional
+
+_SID = re.compile(r"^[0-9A-Fa-f-]{8,64}$")
+_META_PREFIXES = ("<command-", "<local-command", "Caveat:", "<system-reminder")
+MAX_TEXT = 6000
+MAX_FILES = 300
+TITLE_TYPES = ("ai-title", "custom-title", "summary")
+
+# (path, mtime_ns, size) -> summary row. Recomputed only when the file changes.
+_cache: dict[tuple[str, int, int], dict[str, Any]] = {}
+
+
+def projects_root() -> Path:
+    base = os.environ.get("CLAUDE_CONFIG_DIR") or str(Path.home() / ".claude")
+    return Path(base) / "projects"
+
+
+def _text_of(content: Any) -> str:
+    """Only the human-readable text of a message's content; tool blocks are dropped."""
+    if isinstance(content, str):
+        return content
+    if isinstance(content, list):
+        parts = [b.get("text", "") for b in content if isinstance(b, dict) and b.get("type") == "text"]
+        return "\n".join(p for p in parts if p)
+    return ""
+
+
+def _tools_of(content: Any) -> list[str]:
+    if not isinstance(content, list):
+        return []
+    return [str(b.get("name", "tool")) for b in content if isinstance(b, dict) and b.get("type") == "tool_use"]
+
+
+def _is_meta(text: str) -> bool:
+    t = text.lstrip()
+    return not t or t.startswith(_META_PREFIXES)
+
+
+def _iter_records(path: Path):
+    try:
+        with path.open("r", encoding="utf-8", errors="replace") as fh:
+            for line in fh:
+                try:
+                    yield json.loads(line)
+                except ValueError:
+                    continue
+    except OSError:
+        return
+
+
+def _summarise(path: Path) -> dict[str, Any]:
+    st = path.stat()
+    key = (str(path), st.st_mtime_ns, st.st_size)
+    hit = _cache.get(key)
+    if hit is not None:
+        return hit
+    cwd = ""
+    title = ""
+    first_prompt = ""
+    last_prompt = ""
+    first_ts = ""
+    count = 0
+    for rec in _iter_records(path):
+        rtype = rec.get("type")
+        if rtype in TITLE_TYPES:
+            val = rec.get("aiTitle") or rec.get("customTitle") or rec.get("summary") or rec.get("title")
+            if isinstance(val, str) and val.strip():
+                title = val.strip()
+            continue
+        if rtype not in ("user", "assistant") or rec.get("isSidechain"):
+            continue
+        if not cwd and isinstance(rec.get("cwd"), str):
+            cwd = rec["cwd"]
+        if not first_ts and isinstance(rec.get("timestamp"), str):
+            first_ts = rec["timestamp"]
+        msg = rec.get("message") or {}
+        text = _text_of(msg.get("content"))
+        if rtype == "user" and not rec.get("isMeta") and not _is_meta(text):
+            count += 1
+            first_prompt = first_prompt or text.strip()
+            last_prompt = text.strip()
+        elif rtype == "assistant" and text.strip():
+            count += 1
+    row = {
+        "session_id": path.stem,
+        "project": Path(cwd).name if cwd else path.parent.name,
+        "cwd": cwd,
+        "title": (title or first_prompt or "(sin título)")[:140],
+        "last_prompt": last_prompt[:200],
+        "started": first_ts,
+        "updated": st.st_mtime,
+        "messages": count,
+    }
+    for k in [k for k in _cache if k[0] == str(path)]:
+        _cache.pop(k, None)
+    _cache[key] = row
+    return row
+
+
+def list_chats(query: str = "", limit: int = 200, root: Optional[Path] = None) -> list[dict[str, Any]]:
+    root = root or projects_root()
+    if not root.is_dir():
+        return []
+    files = [p for p in root.glob("*/*.jsonl") if p.is_file()]
+    files.sort(key=lambda p: p.stat().st_mtime, reverse=True)
+    q = query.strip().lower()
+    rows: list[dict[str, Any]] = []
+    for p in files[:MAX_FILES]:
+        try:
+            row = _summarise(p)
+        except OSError:
+            continue
+        if row["messages"] == 0:
+            continue
+        if q and q not in f'{row["title"]} {row["project"]} {row["last_prompt"]}'.lower():
+            continue
+        rows.append(row)
+        if len(rows) >= limit:
+            break
+    return rows
+
+
+def read_chat(session_id: str, after: int = 0, limit: int = 400, root: Optional[Path] = None) -> Optional[dict[str, Any]]:
+    """Messages of one conversation, from index ``after`` on. None if it is unknown."""
+    if not _SID.match(session_id or ""):
+        return None
+    root = root or projects_root()
+    matches = list(root.glob(f"*/{session_id}.jsonl")) if root.is_dir() else []
+    if not matches:
+        return None
+    path = matches[0]
+    out: list[dict[str, Any]] = []
+    for rec in _iter_records(path):
+        rtype = rec.get("type")
+        if rtype not in ("user", "assistant") or rec.get("isSidechain") or rec.get("isMeta"):
+            continue
+        msg = rec.get("message") or {}
+        text = _text_of(msg.get("content")).strip()
+        tools = _tools_of(msg.get("content")) if rtype == "assistant" else []
+        if rtype == "user" and _is_meta(text):
+            continue
+        if not text and not tools:
+            continue
+        out.append({
+            "i": len(out),
+            "role": rtype,
+            "ts": rec.get("timestamp", ""),
+            "text": text[:MAX_TEXT] + ("…" if len(text) > MAX_TEXT else ""),
+            "tools": tools[:12],
+        })
+    total = len(out)
+    summary = _summarise(path)
+    return {
+        "session_id": session_id,
+        "title": summary["title"],
+        "project": summary["project"],
+        "cwd": summary["cwd"],
+        "updated": path.stat().st_mtime,
+        "total": total,
+        "messages": out[max(after, 0):][:limit],
+    }
