+FAKE = r'''#!/usr/bin/env python3
+import json, os, sys
+a = sys.argv[1:]
+if a[:2] == ["login", "status"]:
+    if os.environ.get("FAKE_LOGGED_IN") == "1":
+        print("Logged in using ChatGPT"); sys.exit(0)
+    print("Not logged in"); sys.exit(1)
+if a[:1] == ["--version"]:
+    print("codex-cli 9.9.9"); sys.exit(0)
+if a[:1] == ["exec"]:
+    prompt = sys.stdin.read()
+    open(os.environ["FAKE_ARGV_LOG"], "w").write(json.dumps({"argv": a, "prompt": prompt}))
+    print(json.dumps({"type": "thread.started", "thread_id": "t"}))
+    print(json.dumps({"type": "item.started", "item": {"type": "command_execution", "command": "ls"}}))
+    print("not json noise")
+    print(json.dumps({"type": "item.completed", "item": {"type": "agent_message", "text": "Hecho: " + prompt.strip()}}))
+    print(json.dumps({"type": "turn.completed"}))
+    sys.exit(0)
