+.chat-banner-tag { font-family: var(--f-ui); font-size: 11px; font-weight: 700; letter-spacing: 3px; color: #04140d; background: var(--acc); padding: 2px 8px; box-shadow: 0 0 12px var(--acc-glow); }
+.chat-banner-text { font-family: var(--f-mono); font-size: 10px; color: var(--dim); }
+
+/* ── quick actions ────────────────────────────────────────────────────────── */
+.chat-skills { padding: 12px 18px; border-bottom: 1px solid var(--hair); }
+.chat-skills-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
+.chat-skill {
+  display: flex; align-items: center; gap: 10px; text-align: left; padding: 9px 10px; cursor: pointer; font: inherit; color: var(--text);
+  background: rgba(255, 255, 255, 0.025); border: 1px solid var(--hair); border-left: 2px solid var(--acc-line);
+  transition: border-color 0.15s, background 0.15s, transform 0.15s var(--ease);
+}
+.chat-skill:hover { border-color: var(--acc-line); border-left-color: var(--acc); background: var(--acc-soft); transform: translateX(2px); }
+.chat-skill-icon { color: var(--acc); display: grid; place-items: center; }
+.chat-skill-txt { display: flex; flex-direction: column; min-width: 0; }
+.chat-skill-title { font-family: var(--f-ui); font-size: 13.5px; font-weight: 700; letter-spacing: 0.5px; }
+.chat-skill-hint { font-size: 10.5px; color: var(--faint); }
+
+/* ── messages ─────────────────────────────────────────────────────────────── */
+.chat-list { flex: 1; overflow-y: auto; padding: 18px 18px 8px; display: flex; flex-direction: column; gap: 14px; overscroll-behavior: contain; }
+.chat-list::-webkit-scrollbar { width: 6px; }
+.chat-list::-webkit-scrollbar-thumb { background: var(--acc-line); }
+.msg { display: flex; animation: chat-in 0.28s var(--ease); }
+/* Off-screen bubbles skip layout and paint until scrolled to. */
+.msg, .msg-note { content-visibility: auto; contain-intrinsic-size: auto 60px; }
+.chat-list.restoring .msg, .chat-list.restoring .msg-note { animation: none; }
+.msg-user { justify-content: flex-end; }
+.bubble { position: relative; max-width: 90%; padding: 9px 13px 11px; font-size: 14px; line-height: 1.6; overflow-wrap: anywhere; }
+.msg-meta { display: flex; justify-content: space-between; gap: 14px; margin-bottom: 3px; font-family: var(--f-mono); font-size: 9.5px; letter-spacing: 1.2px; }
+.msg-who { color: var(--acc); font-weight: 600; }
+.msg-time { color: var(--faint); }
+.msg-bot .bubble { background: linear-gradient(90deg, var(--acc-soft), rgba(255, 255, 255, 0.02) 40%); border-left: 2px solid var(--acc); box-shadow: inset 0 0 0 1px var(--hair); }
+.msg-bot[data-agent="codex"] .bubble { border-left-color: hsl(156 90% 60%); background: linear-gradient(90deg, hsl(156 90% 55% / 0.12), rgba(255, 255, 255, 0.02) 40%); }
+.msg-bot[data-agent="codex"] .msg-who { color: hsl(156 90% 64%); }
+.msg-user .bubble { background: rgba(255, 255, 255, 0.045); border-right: 2px solid rgba(233, 245, 255, 0.55); box-shadow: inset 0 0 0 1px var(--hair); }
+.msg-user .msg-who { color: var(--dim); }
+.bubble code { font-family: var(--f-mono); font-size: 12.5px; color: var(--acc-strong); background: rgba(0, 0, 0, 0.45); padding: 1px 5px; }
+.bubble pre { margin: 8px 0 2px; padding: 10px 12px; background: rgba(0, 0, 0, 0.55); border: 1px solid var(--hair); border-left: 2px solid var(--acc-line); overflow-x: auto; }
+.bubble pre code { background: none; padding: 0; color: #d6ecff; }
+.bubble strong { color: #fff; }
+
+.msg-typing .bubble { display: flex; flex-direction: column; gap: 7px; min-width: 190px; padding: 11px 14px; }
+.typing-label { font-family: var(--f-ui); font-size: 11px; font-weight: 700; letter-spacing: 3px; color: var(--acc); }
+.typing-bar { position: relative; height: 2px; background: rgba(255, 255, 255, 0.06); overflow: hidden; }
+.typing-bar::after { content: ""; position: absolute; top: 0; bottom: 0; left: 0; width: 35%; background: var(--acc); box-shadow: 0 0 10px var(--acc); animation: chat-load 1.1s var(--ease) infinite; }
+
+.msg-note { align-self: center; max-width: 92%; text-align: center; font-family: var(--f-mono); font-size: 11px; line-height: 1.55; color: var(--dim); padding: 3px 10px; animation: chat-in 0.25s var(--ease); }
+.msg-note code { color: var(--text); background: rgba(0, 0, 0, 0.5); border: 1px solid var(--hair); padding: 3px 8px; display: inline-block; margin-top: 2px; }
+.msg-note.error { color: #ffb3bf; }
+.msg-divider { display: flex; align-items: center; gap: 10px; font-family: var(--f-ui); font-size: 10px; font-weight: 700; letter-spacing: 3px; color: var(--faint); }
+.msg-divider::before, .msg-divider::after { content: ""; flex: 1; height: 1px; background: var(--hair); }
+
+.chat-empty { margin: auto 0; text-align: center; padding: 0 10px 30px; }
+.chat-empty-glyph { width: 46px; height: 46px; margin: 0 auto 16px; border: 1px solid var(--acc-line); transform: rotate(45deg); box-shadow: 0 0 24px var(--acc-soft), inset 0 0 14px var(--acc-soft); position: relative; }
+.chat-empty-glyph::after { content: ""; position: absolute; inset: 14px; background: var(--acc); box-shadow: 0 0 14px var(--acc); }
+.chat-empty-title { font-family: var(--f-ui); font-size: 21px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; }
+.chat-empty-sub { margin: 8px auto 0; max-width: 320px; font-size: 13px; line-height: 1.6; color: var(--dim); }
+
+/* ── composer ─────────────────────────────────────────────────────────────── */
+.chat-composer {
+  display: flex; align-items: flex-end; gap: 8px; margin: 8px 16px 0; padding: 7px 7px 7px 12px;
+  background: rgba(0, 0, 0, 0.35); border: 1px solid var(--acc-line); transition: border-color 0.2s, box-shadow 0.2s;
+}
+.chat-composer:focus-within { border-color: var(--acc); box-shadow: 0 0 0 3px var(--acc-soft), 0 0 26px var(--acc-soft); }
+.chat-prompt { font-family: var(--f-mono); font-size: 17px; line-height: 38px; color: var(--acc); text-shadow: 0 0 8px var(--acc-glow); }
+.chat-input { flex: 1; resize: none; border: 0; outline: 0; background: transparent; color: var(--text); font-family: var(--f-text); font-size: 14px; line-height: 1.5; padding: 8px 0; max-height: 160px; }
+.chat-input::placeholder { color: var(--faint); }
+.chat-send {
+  width: 40px; height: 40px; flex: none; border: 0; cursor: pointer; display: grid; place-items: center; color: #02070c;
+  background: var(--acc); box-shadow: 0 0 18px var(--acc-glow);
+  clip-path: polygon(8px 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%, 0 8px);
+  transition: filter 0.15s, transform 0.12s;
+}
+.chat-send:hover { filter: brightness(1.15); }
+.chat-send:active { transform: scale(0.94); }
+.chat-foot { display: flex; justify-content: center; gap: 16px; padding: 8px 18px 14px; font-family: var(--f-mono); font-size: 9.5px; letter-spacing: 1px; color: var(--faint); }
+
+@keyframes chat-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
+/* transform, not left/top: moving an element by layout properties reflows it every frame. */
+@keyframes chat-load { 0% { transform: translateX(-100%); } 100% { transform: translateX(286%); } }
+@keyframes chat-scan { 0% { transform: translateY(-140px); } 100% { transform: translateY(100vh); } }
+
+/* While he talks, DETENER replaces the state pill so the title keeps its room. */
+.chat-head:has(.chat-stop:not([hidden])) .chat-pill { display: none; }
