new file mode 100644
index 0000000..47693ca
--- /dev/null
+++ b/agents.py
@@ -0,0 +1,192 @@
+"""
+agents.py — which coding agents this machine can use, and a runner for Codex.
+
+Claude Code is JARVIS's own brain and is driven elsewhere (brain.py / run_executor.py). This module
+only *reports* on it. Codex (OpenAI's CLI) is driven here, one `codex exec` at a time, with:
+
+  * no shell — an argv list, and the prompt goes over stdin, so nothing typed can become a flag;
+  * a read-only sandbox by default (JARVIS_CODEX_SANDBOX=workspace-write to let it edit files);
+  * a working directory that must be an existing directory under the user's home;
+  * fixed-string error messages — raw CLI output is never returned to the browser.
+
+The events yielded are plain dicts: {"type": "text"|"tool"|"note"|"error"|"done", ...}.
+"""
+from __future__ import annotations
+
+import asyncio
+import json
+import os
+import shutil
+import subprocess
+from pathlib import Path
+from typing import Any, AsyncIterator, Optional
+
+SANDBOXES = ("read-only", "workspace-write")
+MAX_PROMPT_CHARS = 8000
+RUN_TIMEOUT_S = 15 * 60
+
+INSTALL_HINT = {
+    "claude": "npm install -g @anthropic-ai/claude-code   y luego: claude",
+    "codex": "npm install -g @openai/codex   y luego: codex login",
+}
+
+_run_lock = asyncio.Lock()
+
+
+def find_cli(name: str) -> Optional[str]:
+    return shutil.which(name)
+
+
+def _run(argv: list[str], timeout: float = 8.0) -> Optional[subprocess.CompletedProcess]:
+    try:
+        return subprocess.run(argv, capture_output=True, text=True, timeout=timeout, stdin=subprocess.DEVNULL)
+    except (OSError, subprocess.SubprocessError):
+        return None
+
+
+def _version(path: str) -> str:
+    r = _run([path, "--version"])
+    if r is None or r.returncode != 0:
+        return ""
+    return (r.stdout or r.stderr or "").strip().splitlines()[0][:60] if (r.stdout or r.stderr).strip() else ""
+
+
+def claude_status() -> dict[str, Any]:
+    path = find_cli("claude")
+    if not path:
+        return {"id": "claude", "name": "Claude Code", "installed": False, "logged_in": False, "version": "", "hint": INSTALL_HINT["claude"]}
+    logged = False
+    r = _run([path, "auth", "status"])
+    if r is not None and r.returncode == 0:
+        try:
+            logged = bool(json.loads(r.stdout).get("loggedIn"))
+        except ValueError:
+            logged = "loggedin\": true" in r.stdout.lower().replace(" ", "")
+    return {"id": "claude", "name": "Claude Code", "installed": True, "logged_in": logged, "version": _version(path),
+            "hint": "" if logged else "Ejecuta: claude   (inicia sesión en el navegador)"}
+
+
+def codex_status() -> dict[str, Any]:
+    path = find_cli("codex")
+    if not path:
+        return {"id": "codex", "name": "Codex", "installed": False, "logged_in": False, "version": "", "hint": INSTALL_HINT["codex"]}
+    r = _run([path, "login", "status"])
+    text = ((r.stdout or "") + (r.stderr or "")).lower() if r is not None else ""
+    logged = r is not None and r.returncode == 0 and "not logged in" not in text
+    return {"id": "codex", "name": "Codex", "installed": True, "logged_in": logged, "version": _version(path),
+            "hint": "" if logged else "Ejecuta: codex login   (con tu cuenta de ChatGPT)"}
+
+
+def status() -> list[dict[str, Any]]:
+    return [claude_status(), codex_status()]
+
+
+def resolve_cwd(cwd: Optional[str]) -> Optional[Path]:
+    """An existing directory inside the user's home, or None. Home itself is the default."""
+    home = Path.home().resolve()
+    try:
+        p = Path(cwd).expanduser().resolve() if cwd else home
+    except (OSError, RuntimeError, ValueError):
+        return None
+    if not p.is_dir():
+        return None
+    try:
+        p.relative_to(home)
+    except ValueError:
+        return None
+    return p
+
+
+def _sandbox() -> str:
+    v = os.environ.get("JARVIS_CODEX_SANDBOX", "read-only").strip()
+    return v if v in SANDBOXES else "read-only"
+
+
+def _child_env() -> dict[str, str]:
+    # Codex has no business with JARVIS's own keys or Anthropic credentials.
+    return {k: v for k, v in os.environ.items() if not k.startswith("ANTHROPIC_") and k not in ("FISH_API_KEY",)}
+
+
+def parse_event(line: str) -> list[dict[str, Any]]:
+    """One line of `codex exec --json` -> zero or more UI events. Unknown shapes are ignored."""
+    line = line.strip()
+    if not line.startswith("{"):
+        return []
+    try:
+        ev = json.loads(line)
+    except ValueError:
+        return []
+    kind = ev.get("type")
+    item = ev.get("item") or {}
+    itype = item.get("type")
+    if kind == "item.completed" and itype == "agent_message" and item.get("text"):
+        return [{"type": "text", "text": str(item["text"])}]
+    if kind in ("item.started", "item.completed") and itype in ("command_execution", "mcp_tool_call", "file_change", "web_search"):
+        label = {"command_execution": "shell", "mcp_tool_call": "tool", "file_change": "edición", "web_search": "web"}[itype]
+        return [{"type": "tool", "name": label}] if kind == "item.started" else []
+    if kind in ("turn.failed", "error"):
+        return [{"type": "error", "text": "Codex no pudo completar la petición."}]
+    return []
+
+
+async def run_codex(prompt: str, cwd: Optional[str] = None) -> AsyncIterator[dict[str, Any]]:
+    prompt = (prompt or "").strip()
+    if not prompt:
+        yield {"type": "error", "text": "El mensaje está vacío."}
+        return
+    if len(prompt) > MAX_PROMPT_CHARS:
+        yield {"type": "error", "text": f"El mensaje es demasiado largo (máximo {MAX_PROMPT_CHARS} caracteres)."}
+        return
+    st = await asyncio.to_thread(codex_status)
+    if not st["installed"]:
+        yield {"type": "error", "text": "Codex no está instalado.", "hint": INSTALL_HINT["codex"], "setup": True}
+        return
+    if not st["logged_in"]:
+        yield {"type": "error", "text": "Codex no tiene la sesión iniciada.", "hint": st["hint"], "setup": True}
+        return
+    workdir = resolve_cwd(cwd)
+    if workdir is None:
+        yield {"type": "error", "text": "La carpeta de trabajo no es válida (debe existir y estar dentro de tu carpeta personal)."}
+        return
+    if _run_lock.locked():
+        yield {"type": "error", "text": "Codex ya está ocupado con otra petición."}
+        return
+
+    async with _run_lock:
+        argv = [find_cli("codex") or "codex", "exec", "--skip-git-repo-check", "--sandbox", _sandbox(),
+                "--json", "-C", str(workdir), "-"]
+        try:
+            proc = await asyncio.create_subprocess_exec(
+                *argv, stdin=asyncio.subprocess.PIPE, stdout=asyncio.subprocess.PIPE,
+                stderr=asyncio.subprocess.DEVNULL, env=_child_env())
+        except OSError:
+            yield {"type": "error", "text": "No se pudo iniciar Codex."}
+            return
+        yield {"type": "note", "text": f"Codex trabajando en {workdir.name or str(workdir)} · sandbox {_sandbox()}"}
+        assert proc.stdin is not None and proc.stdout is not None
+        try:
+            proc.stdin.write(prompt.encode("utf-8"))
+            await proc.stdin.drain()
+            proc.stdin.close()
+        except (OSError, ConnectionError):
+            pass
+        got_text = False
+        try:
+            async with asyncio.timeout(RUN_TIMEOUT_S):
+                while True:
+                    raw = await proc.stdout.readline()
+                    if not raw:
+                        break
+                    for ev in parse_event(raw.decode("utf-8", "replace")):
+                        got_text = got_text or ev["type"] == "text"
+                        yield ev
+        except TimeoutError:
+            yield {"type": "error", "text": "Codex tardó demasiado y se detuvo."}
+        finally:
+            # Also runs when the browser disconnects mid-stream: never leave the child running.
+            if proc.returncode is None:
+                proc.kill()
+            await proc.wait()
+        if proc.returncode not in (0, None) and not got_text:
+            yield {"type": "error", "text": "Codex terminó con un error. Comprueba tu sesión (codex login) y tu conexión."}
+        yield {"type": "done"}
diff --git a/chats_view.py b/chats_view.py
new file mode 100644
index 0000000..a363a29
--- /dev/null
+++ b/chats_view.py
@@ -0,0 +1,178 @@
+"""
+chats_view.py — read-only view over Claude Code's own conversation history.
+
+Claude Code keeps every conversation as a JSONL file under
+``<config dir>/projects/<encoded cwd>/<session id>.jsonl``. This module lists
+them and reads one back as plain messages, so the UI can show *all* of the
+user's chats (not only the live ones) and keep them current.
+
+Pure file reading: no subprocess, no writes, no network, no new dependency.
+Everything here is data from a transcript, never instructions.
+"""
+from __future__ import annotations
+
+import json
+import os
+import re
+from pathlib import Path
+from typing import Any, Optional
+
+_SID = re.compile(r"[0-9A-Fa-f-]{8,64}")
+_META_PREFIXES = ("<command-", "<local-command", "Caveat:", "<system-reminder")
+MAX_TEXT = 6000
+MAX_FILES = 300
+TITLE_TYPES = ("ai-title", "custom-title", "summary")
+
+# (path, mtime_ns, size) -> summary row. Recomputed only when the file changes.
+_cache: dict[tuple[str, int, int], dict[str, Any]] = {}
+
+
+def projects_root() -> Path:
+    base = os.environ.get("CLAUDE_CONFIG_DIR") or str(Path.home() / ".claude")
+    return Path(base) / "projects"
+
+
+def _text_of(content: Any) -> str:
+    """Only the human-readable text of a message's content; tool blocks are dropped."""
+    if isinstance(content, str):
+        return content
+    if isinstance(content, list):
+        parts = [b.get("text", "") for b in content if isinstance(b, dict) and b.get("type") == "text"]
+        return "\n".join(p for p in parts if p)
+    return ""
+
+
+def _tools_of(content: Any) -> list[str]:
+    if not isinstance(content, list):
+        return []
+    return [str(b.get("name", "tool")) for b in content if isinstance(b, dict) and b.get("type") == "tool_use"]
+
+
+def _is_meta(text: str) -> bool:
+    t = text.lstrip()
+    return not t or t.startswith(_META_PREFIXES)
+
+
+def _iter_records(path: Path):
+    try:
+        with path.open("r", encoding="utf-8", errors="replace") as fh:
+            for line in fh:
+                try:
+                    yield json.loads(line)
+                except ValueError:
+                    continue
+    except OSError:
+        return
+
+
+def _summarise(path: Path) -> dict[str, Any]:
+    st = path.stat()
+    key = (str(path), st.st_mtime_ns, st.st_size)
+    hit = _cache.get(key)
+    if hit is not None:
+        return hit
+    cwd = ""
+    title = ""
+    first_prompt = ""
+    last_prompt = ""
+    first_ts = ""
+    count = 0
+    for rec in _iter_records(path):
+        rtype = rec.get("type")
+        if rtype in TITLE_TYPES:
+            val = rec.get("aiTitle") or rec.get("customTitle") or rec.get("summary") or rec.get("title")
+            if isinstance(val, str) and val.strip():
+                title = val.strip()
+            continue
+        if rtype not in ("user", "assistant") or rec.get("isSidechain"):
+            continue
+        if not cwd and isinstance(rec.get("cwd"), str):
+            cwd = rec["cwd"]
+        if not first_ts and isinstance(rec.get("timestamp"), str):
+            first_ts = rec["timestamp"]
+        msg = rec.get("message") or {}
+        text = _text_of(msg.get("content"))
+        if rtype == "user" and not rec.get("isMeta") and not _is_meta(text):
+            count += 1
+            first_prompt = first_prompt or text.strip()
+            last_prompt = text.strip()
+        elif rtype == "assistant" and text.strip():
+            count += 1
+    row = {
+        "session_id": path.stem,
+        "project": Path(cwd).name if cwd else path.parent.name,
+        "cwd": cwd,
+        "title": (title or first_prompt or "(sin título)")[:140],
+        "last_prompt": last_prompt[:200],
+        "started": first_ts,
+        "updated": st.st_mtime,
+        "messages": count,
+    }
+    for k in [k for k in _cache if k[0] == str(path)]:
+        _cache.pop(k, None)
+    _cache[key] = row
+    return row
+
+
+def list_chats(query: str = "", limit: int = 200, root: Optional[Path] = None) -> list[dict[str, Any]]:
+    root = root or projects_root()
+    if not root.is_dir():
+        return []
+    files = [p for p in root.glob("*/*.jsonl") if p.is_file()]
+    files.sort(key=lambda p: p.stat().st_mtime, reverse=True)
+    q = query.strip().lower()
+    rows: list[dict[str, Any]] = []
+    for p in files[:MAX_FILES]:
+        try:
+            row = _summarise(p)
+        except OSError:
+            continue
+        if row["messages"] == 0:
+            continue
+        if q and q not in f'{row["title"]} {row["project"]} {row["last_prompt"]}'.lower():
+            continue
+        rows.append(row)
+        if len(rows) >= limit:
+            break
+    return rows
+
+
+def read_chat(session_id: str, after: int = 0, limit: int = 400, root: Optional[Path] = None) -> Optional[dict[str, Any]]:
+    """Messages of one conversation, from index ``after`` on. None if it is unknown."""
+    if not _SID.fullmatch(session_id or ""):
+        return None
+    root = root or projects_root()
+    matches = list(root.glob(f"*/{session_id}.jsonl")) if root.is_dir() else []
+    if not matches:
+        return None
+    path = matches[0]
+    out: list[dict[str, Any]] = []
+    for rec in _iter_records(path):
+        rtype = rec.get("type")
+        if rtype not in ("user", "assistant") or rec.get("isSidechain") or rec.get("isMeta"):
+            continue
+        msg = rec.get("message") or {}
+        text = _text_of(msg.get("content")).strip()
+        tools = _tools_of(msg.get("content")) if rtype == "assistant" else []
+        if rtype == "user" and _is_meta(text):
+            continue
+        if not text and not tools:
+            continue
+        out.append({
+            "i": len(out),
+            "role": rtype,
+            "ts": rec.get("timestamp", ""),
+            "text": text[:MAX_TEXT] + ("…" if len(text) > MAX_TEXT else ""),
+            "tools": tools[:12],
+        })
+    total = len(out)
+    summary = _summarise(path)
+    return {
+        "session_id": session_id,
+        "title": summary["title"],
+        "project": summary["project"],
+        "cwd": summary["cwd"],
+        "updated": path.stat().st_mtime,
+        "total": total,
+        "messages": out[max(after, 0):][:limit],
+    }
