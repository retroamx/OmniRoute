index 0000000..bdb25d3
--- /dev/null
+++ b/transfer.py
@@ -0,0 +1,170 @@
+"""
+transfer.py — move your history from one computer to another.
+
+export_zip()  builds a .zip with
+    claude/projects/<dir>/<session>.jsonl   every Claude Code conversation on this machine
+    jarvis/MEMORY.md, jarvis/memory/**.md,
+    jarvis/journal/**.md                    JARVIS's long-term memory (plain Markdown)
+    jarvis/chat-history.json                the chat panel's history (sent by the browser)
+    manifest.json
+
+import_zip()  unpacks such a file on the other machine. It is deliberately narrow:
+  * only the three shapes above are accepted, by exact pattern — anything else in the
+    archive is skipped (no path traversal, no absolute paths, no symlinks, no other files);
+  * nothing that already exists is overwritten, except a conversation whose imported copy
+    is longer (a transcript only ever grows, so the longer one is the newer one);
+  * sizes are capped per file and in total.
+Credentials are never exported: not ~/.claude/.credentials.json, not JARVIS's tool token,
+connections.json or .env.
+"""
+from __future__ import annotations
+
+import io
+import json
+import os
+import re
+import time
+import zipfile
+from pathlib import Path
+from typing import Any, Optional
+
+import chats_view
+import data_paths
+
+FORMAT = "jarvis-transfer/1"
+MAX_FILE = 200 * 1024 * 1024
+MAX_TOTAL = 1024 * 1024 * 1024
+MAX_CHAT_HISTORY = 5 * 1024 * 1024
+
+_SAFE = r"[A-Za-z0-9._-]{1,200}"
+_PROJECT_ENTRY = re.compile(rf"claude/projects/({_SAFE})/({_SAFE}\.jsonl)")
+_MEMORY_ENTRY = re.compile(r"jarvis/((?:memory|journal)/(?:[A-Za-z0-9._ -]{1,120}/){0,4}[A-Za-z0-9._ -]{1,160}\.md|MEMORY\.md)")
+_CHAT_ENTRY = "jarvis/chat-history.json"
+
+
+def _brain_home() -> Path:
+    return data_paths.brain_home()
+
+
+def _memory_files(home: Path) -> list[Path]:
+    out: list[Path] = []
+    index = home / "MEMORY.md"
+    if index.is_file():
+        out.append(index)
+    for sub in ("memory", "journal"):
+        root = home / sub
+        if root.is_dir():
+            out += [p for p in root.rglob("*.md") if p.is_file() and not p.is_symlink()]
+    return out
+
+
+def export_zip(chat_history: Optional[list] = None, projects_root: Optional[Path] = None,
+               brain_home: Optional[Path] = None) -> tuple[bytes, dict[str, int]]:
+    projects_root = projects_root or chats_view.projects_root()
+    brain_home = brain_home or _brain_home()
+    counts = {"conversations": 0, "memory_files": 0, "chat_messages": 0, "skipped_large": 0}
+    buf = io.BytesIO()
+    total = 0
+    with zipfile.ZipFile(buf, "w", compression=zipfile.ZIP_DEFLATED, compresslevel=6) as z:
+        if projects_root.is_dir():
+            for f in sorted(projects_root.glob("*/*.jsonl")):
+                if not f.is_file() or f.is_symlink():
+                    continue
+                name = f"claude/projects/{f.parent.name}/{f.name}"
+                size = f.stat().st_size
+                if not _PROJECT_ENTRY.fullmatch(name) or size > MAX_FILE or total + size > MAX_TOTAL:
+                    counts["skipped_large"] += 1
+                    continue
+                z.write(f, name)
+                total += size
+                counts["conversations"] += 1
+        for f in _memory_files(brain_home):
+            name = "jarvis/" + f.relative_to(brain_home).as_posix()
+            if _MEMORY_ENTRY.fullmatch(name):
+                z.write(f, name)
+                counts["memory_files"] += 1
+        if isinstance(chat_history, list) and chat_history:
+            data = json.dumps(chat_history, ensure_ascii=False)
+            if len(data) <= MAX_CHAT_HISTORY:
+                z.writestr(_CHAT_ENTRY, data)
+                counts["chat_messages"] = len(chat_history)
+        z.writestr("manifest.json", json.dumps({
+            "format": FORMAT, "created": time.time(), "counts": counts,
+        }, indent=2))
+    return buf.getvalue(), counts
+
+
+def import_zip(blob: bytes, projects_root: Optional[Path] = None,
+               brain_home: Optional[Path] = None) -> dict[str, Any]:
+    projects_root = projects_root or chats_view.projects_root()
+    brain_home = brain_home or _brain_home()
+    result: dict[str, Any] = {"conversations": 0, "updated": 0, "memory_files": 0,
+                              "skipped": 0, "chat_history": []}
+    try:
+        z = zipfile.ZipFile(io.BytesIO(blob))
+    except zipfile.BadZipFile:
+        raise ValueError("El archivo no es un .zip de JARVIS válido.")
+    with z:
+        try:
+            manifest = json.loads(z.read("manifest.json"))
+        except (KeyError, ValueError):
+            raise ValueError("El archivo no es una exportación de JARVIS (falta manifest.json).")
+        if manifest.get("format") != FORMAT:
+            raise ValueError("Formato de exportación no reconocido.")
+        total = 0
+        for info in z.infolist():
+            name = info.filename
+            if info.is_dir() or name == "manifest.json":
+                continue
+            # Symlinks stored in a zip carry the S_IFLNK bit in the high bits of external_attr.
+            if (info.external_attr >> 16) & 0o170000 == 0o120000:
+                result["skipped"] += 1
+                continue
+            if info.file_size > MAX_FILE or total + info.file_size > MAX_TOTAL:
+                result["skipped"] += 1
+                continue
+            m = _PROJECT_ENTRY.fullmatch(name)
+            if m:
+                dest = projects_root / m.group(1) / m.group(2)
+                data = z.read(info)
+                total += len(data)
+                if dest.exists():
+                    if dest.stat().st_size >= len(data):
+                        continue
+                    result["updated"] += 1
+                else:
+                    result["conversations"] += 1
+                dest.parent.mkdir(parents=True, exist_ok=True)
+                _atomic_write(dest, data)
+                continue
+            m = _MEMORY_ENTRY.fullmatch(name)
+            if m:
+                rel = Path(*m.group(1).split("/"))
+                if any(part in ("..", "") for part in rel.parts):
+                    result["skipped"] += 1
+                    continue
+                dest = brain_home / rel
+                if dest.exists():
+                    continue
+                data = z.read(info)
+                total += len(data)
+                dest.parent.mkdir(parents=True, exist_ok=True)
+                _atomic_write(dest, data)
+                result["memory_files"] += 1
+                continue
+            if name == _CHAT_ENTRY and info.file_size <= MAX_CHAT_HISTORY:
+                try:
+                    items = json.loads(z.read(info))
+                    if isinstance(items, list):
+                        result["chat_history"] = items
+                except ValueError:
+                    result["skipped"] += 1
+                continue
+            result["skipped"] += 1
+    return result
+
+
+def _atomic_write(dest: Path, data: bytes) -> None:
+    tmp = dest.with_name(dest.name + ".importing")
+    tmp.write_bytes(data)
+    os.replace(tmp, dest)
diff --git a/tts.py b/tts.py
index 722c001..951cb26 100644
--- a/tts.py
+++ b/tts.py
@@ -62,3 +62,67 @@ async def synthesize_chunk(text: str, *, api_key: str, voice_id: str,
     if not buf:
         return None
     return SynthResult(bytes(buf), first if first is not None else 0.0, time.monotonic() - t0)
+
+
+async def synthesize_local(text: str, *, voice: str = "en-gb", speed: int = 165,
+                           timeout: float = 15.0) -> Optional[SynthResult]:
+    """Offline fallback: espeak-ng -> ffmpeg -> MP3. No network, no API key."""
+    import asyncio
+    import shutil
+    text = (text or "").strip()
+    if not text or not shutil.which("espeak-ng") or not shutil.which("ffmpeg"):
+        return None
+    t0 = time.monotonic()
+    try:
+        # Text goes over stdin, never into an argv/shell string.
+        espeak = await asyncio.create_subprocess_exec(
+            "espeak-ng", "-v", voice, "-s", str(speed), "--stdout", "--stdin",
+            stdin=asyncio.subprocess.PIPE, stdout=asyncio.subprocess.PIPE,
+            stderr=asyncio.subprocess.DEVNULL)
+        wav, _ = await asyncio.wait_for(espeak.communicate(text.encode()), timeout)
+        if not wav:
+            return None
+        ffmpeg = await asyncio.create_subprocess_exec(
+            "ffmpeg", "-loglevel", "error", "-i", "pipe:0", "-f", "mp3", "-b:a", "128k", "pipe:1",
+            stdin=asyncio.subprocess.PIPE, stdout=asyncio.subprocess.PIPE,
+            stderr=asyncio.subprocess.DEVNULL)
+        mp3, _ = await asyncio.wait_for(ffmpeg.communicate(wav), timeout)
+    except (OSError, asyncio.TimeoutError) as e:
+        log.error(f"local TTS error: {e}")
+        return None
+    if not mp3:
+        return None
+    dt = time.monotonic() - t0
+    return SynthResult(mp3, dt, dt)
+
+
+async def synthesize_edge(text: str, *, voice: str = "en-GB-RyanNeural", timeout: float = 15.0) -> Optional[SynthResult]:
+    """Free neural voice via Microsoft Edge TTS (pip install edge-tts). Needs internet, no API key."""
+    import asyncio
+    text = (text or "").strip()
+    if not text:
+        return None
+    try:
+        import edge_tts
+    except ImportError:
+        return None
+    t0 = time.monotonic()
+    first: Optional[float] = None
+    buf = bytearray()
+
+    async def _run() -> None:
+        nonlocal first
+        async for chunk in edge_tts.Communicate(text, voice).stream():
+            if chunk.get("type") == "audio":
+                if first is None:
+                    first = time.monotonic() - t0
+                buf.extend(chunk["data"])
+
+    try:
+        await asyncio.wait_for(_run(), timeout)
+    except Exception as e:      # network/API failures must fall through to the next engine
+        log.error(f"edge TTS error: {e}")
+        return None
+    if not buf:
+        return None
+    return SynthResult(bytes(buf), first if first is not None else 0.0, time.monotonic() - t0)
diff --git a/usage_scan.py b/usage_scan.py
index 7aa2dd6..ccb0d3c 100644
--- a/usage_scan.py
+++ b/usage_scan.py
@@ -67,7 +67,7 @@ import logging
 import os
 import time
 from dataclasses import dataclass, field
-from datetime import datetime
+from datetime import datetime, timezone
 from pathlib import Path
 
 import session_watch
@@ -158,8 +158,18 @@ def _tokens_from(usage) -> Tokens:
 # `fromisoformat` accepts that string happily, so catching only its ValueError
 # left the second call unguarded. Two years of slack at each end covers every
 # UTC offset without needing to know the local one.
-_DAY_MIN = datetime(2, 1, 1).timestamp()
-_DAY_MAX = datetime(9997, 1, 1).timestamp()
+#
+# Computed from UTC-aware datetimes: a naive `datetime(2, 1, 1).timestamp()` asks the OS
+# for LOCAL time in year 2, which Windows cannot do (OSError: [Errno 22]) — JARVIS then
+# failed at import and never started there. Windows' `fromtimestamp` also only accepts
+# moments from the epoch to year 3000, so the window is narrowed to that range there,
+# again with two days of slack for the UTC offset.
+if os.name == "nt":
+    _DAY_MIN = 2 * 86400.0
+    _DAY_MAX = datetime(2999, 12, 29, tzinfo=timezone.utc).timestamp()
+else:
+    _DAY_MIN = datetime(2, 1, 1, tzinfo=timezone.utc).timestamp()
+    _DAY_MAX = datetime(9997, 1, 1, tzinfo=timezone.utc).timestamp()
 
 
 def _epoch(stamp) -> float | None:
