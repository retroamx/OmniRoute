+
+def test_prompt_goes_over_stdin_never_in_argv_and_sandbox_is_read_only(fake_codex):
+    _collect("--dangerously-bypass-approvals-and-sandbox")     # would be a flag if it ever reached argv
+    logged = json.loads((fake_codex / "argv.json").read_text())
+    assert "--dangerously-bypass-approvals-and-sandbox" not in logged["argv"]
+    assert logged["prompt"] == "--dangerously-bypass-approvals-and-sandbox"
