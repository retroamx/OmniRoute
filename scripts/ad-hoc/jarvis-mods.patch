+async def api_transfer_export(request: Request):
+    """Download every Claude Code conversation + JARVIS memory (+ the chat panel history) as a .zip."""
+    try:
+        body = await request.json()
+    except ValueError:
+        body = {}
+    history = body.get("chat_history") if isinstance(body, dict) else None
+    blob, counts = await asyncio.to_thread(transfer.export_zip, history if isinstance(history, list) else None)
+    stamp = time.strftime("%Y-%m-%d")
+    return Response(content=blob, media_type="application/zip", headers={
+        "Content-Disposition": f'attachment; filename="jarvis-conversaciones-{stamp}.zip"',
+        "X-Jarvis-Counts": json.dumps(counts),
+    })
+
+
+@app.post("/api/transfer/import")
+async def api_transfer_import(request: Request):
+    """Unpack a file made by /api/transfer/export. Never overwrites what is already here."""
+    length = request.headers.get("content-length")
+    if length and length.isdigit() and int(length) > transfer.MAX_TOTAL:
+        return JSONResponse({"error": "El archivo es demasiado grande."}, status_code=413)
+    blob = await request.body()
+    if len(blob) > transfer.MAX_TOTAL:
+        return JSONResponse({"error": "El archivo es demasiado grande."}, status_code=413)
+    try:
+        result = await asyncio.to_thread(transfer.import_zip, blob)
+    except ValueError as e:
+        return JSONResponse({"error": str(e)}, status_code=400)
+    return result
+
+
+@app.get("/api/agents")
+async def api_agents():
+    """Which coding agents (Claude Code, Codex) are installed and signed in on this machine."""
+    return {"agents": await asyncio.to_thread(agents.status)}
+
+
+@app.post("/api/agents/codex/exec")
+async def api_codex_exec(request: Request):
+    """Run one Codex turn and stream its events as newline-delimited JSON."""
+    try:
+        body = await request.json()
+    except ValueError:
+        return JSONResponse({"error": "invalid JSON"}, status_code=400)
+    if not isinstance(body, dict):
+        return JSONResponse({"error": "invalid body"}, status_code=400)
+    prompt = body.get("prompt")
+    cwd = body.get("cwd")
+    if not isinstance(prompt, str) or (cwd is not None and not isinstance(cwd, str)):
+        return JSONResponse({"error": "invalid body"}, status_code=400)
+
+    async def stream():
+        async for ev in agents.run_codex(prompt, cwd):
+            yield json.dumps(ev, ensure_ascii=False) + "\n"
+
+    return StreamingResponse(stream(), media_type="application/x-ndjson")
+
+
+@app.get("/api/chats")
+async def api_list_chats(q: str = "", limit: int = 200):
+    """Every Claude Code conversation on disk (not only the live ones), newest first."""
+    # JARVIS's own brain and its runs are Claude Code conversations too; they are not the user's chats.
+    own = (data_paths.data_dir().resolve(),)
+    rows = await asyncio.to_thread(chats_view.list_chats, q[:200], max(1, min(limit, 500)), None, own)
+    return {"chats": rows}
+
+
+@app.get("/api/chats/{session_id}")
+async def api_read_chat(session_id: str, after: int = 0):
+    """One conversation as plain messages, from index `after` — the UI polls this
+    to stay current without refetching what it already has."""
+    chat = await asyncio.to_thread(chats_view.read_chat, session_id, max(after, 0))
+    if chat is None:
+        return JSONResponse({"error": "conversation not found"}, status_code=404)
+    return chat
+
+
 # The tool result cap is what keeps the brain's context under budget.
 TOOL_RESULT_CAP = 1500
 
