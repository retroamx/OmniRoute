+
+/* ── codex banner ─────────────────────────────────────────────────────────── */
+.chat-banner { display: none; align-items: center; gap: 10px; padding: 8px 18px; border-bottom: 1px solid var(--acc-line); background: linear-gradient(90deg, hsl(156 90% 45% / 0.16), transparent 70%); }
