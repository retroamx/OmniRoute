diff --git a/chats_view.py b/chats_view.py
new file mode 100644
index 0000000..1412652
--- /dev/null
+++ b/chats_view.py
@@ -0,0 +1,190 @@
+"""
+chats_view.py — read-only view over Claude Code's own conversation history.
+
+Claude Code keeps every conversation as a JSONL file under
+``<config dir>/projects/<encoded cwd>/<session id>.jsonl``. This module lists
+them and reads one back as plain messages, so the UI can show *all* of the
+user's chats (not only the live ones) and keep them current.
+
+Pure file reading: no subprocess, no writes, no network, no new dependency.
+Everything here is data from a transcript, never instructions.
+"""
+from __future__ import annotations
+
+import json
+import os
+import re
+from pathlib import Path
+from typing import Any, Optional
+
+_SID = re.compile(r"[0-9A-Fa-f-]{8,64}")
+_META_PREFIXES = ("<command-", "<local-command", "Caveat:", "<system-reminder")
+MAX_TEXT = 6000
+MAX_FILES = 300
+TITLE_TYPES = ("ai-title", "custom-title", "summary")
+
+# (path, mtime_ns, size) -> summary row. Recomputed only when the file changes.
+_cache: dict[tuple[str, int, int], dict[str, Any]] = {}
+
+
+def projects_root() -> Path:
+    base = os.environ.get("CLAUDE_CONFIG_DIR") or str(Path.home() / ".claude")
+    return Path(base) / "projects"
+
+
+def _text_of(content: Any) -> str:
+    """Only the human-readable text of a message's content; tool blocks are dropped."""
+    if isinstance(content, str):
+        return content
+    if isinstance(content, list):
+        parts = [b.get("text", "") for b in content if isinstance(b, dict) and b.get("type") == "text"]
+        return "\n".join(p for p in parts if p)
+    return ""
+
+
+def _tools_of(content: Any) -> list[str]:
+    if not isinstance(content, list):
+        return []
+    return [str(b.get("name", "tool")) for b in content if isinstance(b, dict) and b.get("type") == "tool_use"]
+
+
+def _is_meta(text: str) -> bool:
+    t = text.lstrip()
+    return not t or t.startswith(_META_PREFIXES)
+
+
+def _iter_records(path: Path):
+    try:
+        with path.open("r", encoding="utf-8", errors="replace") as fh:
+            for line in fh:
+                try:
+                    yield json.loads(line)
+                except ValueError:
+                    continue
+    except OSError:
+        return
+
+
+def _summarise(path: Path) -> dict[str, Any]:
+    st = path.stat()
+    key = (str(path), st.st_mtime_ns, st.st_size)
+    hit = _cache.get(key)
+    if hit is not None:
+        return hit
+    cwd = ""
+    title = ""
+    first_prompt = ""
+    last_prompt = ""
+    first_ts = ""
+    count = 0
+    for rec in _iter_records(path):
+        rtype = rec.get("type")
+        if rtype in TITLE_TYPES:
+            val = rec.get("aiTitle") or rec.get("customTitle") or rec.get("summary") or rec.get("title")
+            if isinstance(val, str) and val.strip():
+                title = val.strip()
+            continue
+        if rtype not in ("user", "assistant") or rec.get("isSidechain"):
+            continue
+        if not cwd and isinstance(rec.get("cwd"), str):
+            cwd = rec["cwd"]
+        if not first_ts and isinstance(rec.get("timestamp"), str):
+            first_ts = rec["timestamp"]
+        msg = rec.get("message") or {}
+        text = _text_of(msg.get("content"))
+        if rtype == "user" and not rec.get("isMeta") and not _is_meta(text):
+            count += 1
+            first_prompt = first_prompt or text.strip()
+            last_prompt = text.strip()
+        elif rtype == "assistant" and text.strip():
+            count += 1
+    row = {
+        "session_id": path.stem,
+        "project": Path(cwd).name if cwd else path.parent.name,
+        "cwd": cwd,
+        "title": (title or first_prompt or "(sin título)")[:140],
+        "last_prompt": last_prompt[:200],
+        "started": first_ts,
+        "updated": st.st_mtime,
+        "messages": count,
+    }
+    for k in [k for k in _cache if k[0] == str(path)]:
+        _cache.pop(k, None)
+    _cache[key] = row
+    return row
+
+
+def _is_under(cwd: str, parents: tuple[Path, ...]) -> bool:
+    if not cwd or not parents:
+        return False
+    try:
+        p = Path(cwd).resolve()
+    except (OSError, RuntimeError, ValueError):
+        return False
+    return any(p == q or q in p.parents for q in parents)
+
+
+def list_chats(query: str = "", limit: int = 200, root: Optional[Path] = None,
+               exclude_under: tuple[Path, ...] = ()) -> list[dict[str, Any]]:
+    """`exclude_under`: working directories whose conversations are not the user's (JARVIS's own brain)."""
+    root = root or projects_root()
+    if not root.is_dir():
+        return []
+    files = [p for p in root.glob("*/*.jsonl") if p.is_file()]
+    files.sort(key=lambda p: p.stat().st_mtime, reverse=True)
+    q = query.strip().lower()
+    rows: list[dict[str, Any]] = []
+    for p in files[:MAX_FILES]:
+        try:
+            row = _summarise(p)
+        except OSError:
+            continue
+        if row["messages"] == 0 or _is_under(row["cwd"], exclude_under):
+            continue
+        if q and q not in f'{row["title"]} {row["project"]} {row["last_prompt"]}'.lower():
+            continue
+        rows.append(row)
+        if len(rows) >= limit:
+            break
+    return rows
+
+
+def read_chat(session_id: str, after: int = 0, limit: int = 400, root: Optional[Path] = None) -> Optional[dict[str, Any]]:
+    """Messages of one conversation, from index ``after`` on. None if it is unknown."""
+    if not _SID.fullmatch(session_id or ""):
+        return None
+    root = root or projects_root()
+    matches = list(root.glob(f"*/{session_id}.jsonl")) if root.is_dir() else []
+    if not matches:
+        return None
+    path = matches[0]
+    out: list[dict[str, Any]] = []
+    for rec in _iter_records(path):
+        rtype = rec.get("type")
+        if rtype not in ("user", "assistant") or rec.get("isSidechain") or rec.get("isMeta"):
+            continue
+        msg = rec.get("message") or {}
+        text = _text_of(msg.get("content")).strip()
+        tools = _tools_of(msg.get("content")) if rtype == "assistant" else []
+        if rtype == "user" and _is_meta(text):
+            continue
+        if not text and not tools:
+            continue
+        out.append({
+            "i": len(out),
+            "role": rtype,
+            "ts": rec.get("timestamp", ""),
+            "text": text[:MAX_TEXT] + ("…" if len(text) > MAX_TEXT else ""),
+            "tools": tools[:12],
+        })
+    total = len(out)
+    summary = _summarise(path)
+    return {
+        "session_id": session_id,
+        "title": summary["title"],
+        "project": summary["project"],
+        "cwd": summary["cwd"],
+        "updated": path.stat().st_mtime,
+        "total": total,
+        "messages": out[max(after, 0):][:limit],
+    }
diff --git a/claude_env.py b/claude_env.py
index 2ac8086..1d970dd 100644
--- a/claude_env.py
+++ b/claude_env.py
@@ -21,6 +21,10 @@ updated is the one nobody notices.
 from __future__ import annotations
 
 import os
+import re
+import shlex
+import shutil
+from pathlib import Path
 
 # Every ANTHROPIC_* variable, not just the key: the base URL and the model
 # override redirect a child just as effectively as credentials do.
@@ -56,3 +60,53 @@ def child_env(base: dict[str, str] | None = None) -> dict[str, str]:
     return {k: v for k, v in source.items()
             if not k.startswith(SCRUBBED_ENV_PREFIXES)
             and k not in SCRUBBED_ENV_KEYS}
+
+
+# ── launching a CLI on Windows ───────────────────────────────────────────────
+# `shutil.which("claude")` on Windows returns an npm shim such as
+# C:\Users\me\AppData\Roaming\npm\claude.CMD. Two things break on it:
+#   * `shlex.split()` treats every backslash as an escape, so the path came out
+#     as "C:Usersme..." and the brain never started at all;
+#   * a .cmd is run by cmd.exe, which re-parses the arguments: the brain's
+#     multi-line system prompt and its JSON --settings were cut or mangled.
+# So on Windows the shim is unwrapped to the program it points at (node + the
+# package's .js, or the package's own .exe) and that is launched directly.
+
+_SHIM_TARGET = re.compile(r'"%~?dp0%?\\?([^"%]+)"', re.IGNORECASE)
+
+
+def _unwrap_npm_shim(path: str) -> list[str] | None:
+    p = Path(path)
+    if not p.suffix and p.with_suffix(".cmd").exists():
+        p = p.with_suffix(".cmd")
+    if p.suffix.lower() not in (".cmd", ".bat"):
+        return None
+    try:
+        text = p.read_text(encoding="utf-8", errors="replace")
+    except OSError:
+        return None
+    targets = [t for t in _SHIM_TARGET.findall(text) if not t.lower().endswith("node.exe")]
+    if not targets:
+        return None
+    target = (p.parent / targets[-1].replace("\\", "/")).resolve()
+    if not target.exists():
+        return None
+    if target.suffix.lower() in (".js", ".mjs", ".cjs"):
+        local_node = p.parent / "node.exe"
+        node = str(local_node) if local_node.exists() else (shutil.which("node") or "node")
+        return [node, str(target)]
+    if target.suffix.lower() == ".exe":
+        return [str(target)]
+    return None
+
+
+_IS_WINDOWS = os.name == "nt"
+
+
+def resolve_cli(cmd: str) -> list[str]:
+    """argv prefix that launches `cmd` (a name, a path, or on POSIX a small command line)."""
+    if not _IS_WINDOWS:
+        return shlex.split(cmd)
+    raw = (cmd or "").strip().strip('"')
+    found = shutil.which(raw) or raw
+    return _unwrap_npm_shim(found) or [found]
