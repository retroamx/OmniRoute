+async def synthesize_local(text: str, *, voice: str = "en-gb", speed: int = 165,
+                           timeout: float = 15.0) -> Optional[SynthResult]:
+    """Offline fallback: espeak-ng -> ffmpeg -> MP3. No network, no API key."""
+    import asyncio
+    import shutil
+    text = (text or "").strip()
+    if not text or not shutil.which("espeak-ng") or not shutil.which("ffmpeg"):
+        return None
+    t0 = time.monotonic()
+    try:
+        # Text goes over stdin, never into an argv/shell string.
+        espeak = await asyncio.create_subprocess_exec(
+            "espeak-ng", "-v", voice, "-s", str(speed), "--stdout", "--stdin",
+            stdin=asyncio.subprocess.PIPE, stdout=asyncio.subprocess.PIPE,
+            stderr=asyncio.subprocess.DEVNULL)
+        wav, _ = await asyncio.wait_for(espeak.communicate(text.encode()), timeout)
+        if not wav:
+            return None
+        ffmpeg = await asyncio.create_subprocess_exec(
+            "ffmpeg", "-loglevel", "error", "-i", "pipe:0", "-f", "mp3", "-b:a", "128k", "pipe:1",
+            stdin=asyncio.subprocess.PIPE, stdout=asyncio.subprocess.PIPE,
+            stderr=asyncio.subprocess.DEVNULL)
+        mp3, _ = await asyncio.wait_for(ffmpeg.communicate(wav), timeout)
+    except (OSError, asyncio.TimeoutError) as e:
+        log.error(f"local TTS error: {e}")
+        return None
+    if not mp3:
+        return None
+    dt = time.monotonic() - t0
+    return SynthResult(mp3, dt, dt)
