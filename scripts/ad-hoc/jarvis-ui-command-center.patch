diff --git a/frontend/src/hud.ts b/frontend/src/hud.ts
new file mode 100644
index 0000000..f19fb12
--- /dev/null
+++ b/frontend/src/hud.ts
@@ -0,0 +1,171 @@
+/**
+ * Command-centre HUD around the orb: brand + clock, mode switch, live vitals
+ * (subscription windows, today's runs, recent runs) and a terminals bar that
+ * lists every Claude Code session on the machine. All numbers come from the
+ * JARVIS REST API — nothing here is sample data.
+ */
+
+import "./hud.css";
+
+interface LimitWindow {
+  key: string;
+  label: string;
+  utilization: number | null;
+  resets_at: number | null;
+}
+interface SessionRow {
+  session_id: string;
+  project?: string;
+  state?: string;
+  needs_a_human_hand?: boolean;
+}
+interface RunRow {
+  run_id?: string;
+  id?: string;
+  status?: string;
+  prompt?: string;
+  project?: string;
+}
+
+function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string): HTMLElementTagNameMap[K] {
+  const n = document.createElement(tag);
+  if (cls) n.className = cls;
+  if (text !== undefined) n.textContent = text;
+  return n;
+}
+
+async function getJson<T>(url: string): Promise<T | null> {
+  try {
+    const r = await fetch(url);
+    return r.ok ? ((await r.json()) as T) : null;
+  } catch {
+    return null;
+  }
+}
+
+function fmtReset(epoch: number | null): string {
+  if (!epoch) return "";
+  const mins = Math.max(0, Math.round((epoch * 1000 - Date.now()) / 60000));
+  if (mins < 90) return `reinicia en ${mins} min`;
+  const h = Math.round(mins / 60);
+  return h < 48 ? `reinicia en ${h} h` : `reinicia en ${Math.round(h / 24)} d`;
+}
+
+function fmtTokens(n: number): string {
+  return n >= 1e6 ? (n / 1e6).toFixed(1) + "M" : n >= 1e3 ? (n / 1e3).toFixed(1) + "k" : String(n);
+}
+
+export function createHud(opts: { onTalk(): void }) {
+  // ── top-left: brand + clock ──────────────────────────────────────────────
+  const brand = el("div", "hud-brand");
+  const title = el("div", "hud-title");
+  title.append("JARVIS", el("small", "", " / V2"));
+  const tag = el("div", "hud-tag", "TU CENTRO DE MANDO");
+  const clock = el("div", "hud-clock");
+  const date = el("div", "hud-date");
+  brand.append(title, tag, clock, date);
+
+  // ── top-centre: mode switch ──────────────────────────────────────────────
+  const modes = el("div", "hud-modes");
+  const mClaude = el("button", "hud-mode active", "Claude Code");
+  const mCodex = el("button", "hud-mode", "Codex");
+  mClaude.type = mCodex.type = "button";
+  mCodex.disabled = true;
+  mCodex.title = "No disponible en esta versión de JARVIS";
+  modes.append(mClaude, mCodex);
+
+  // ── left: vitals ─────────────────────────────────────────────────────────
+  const left = el("aside", "hud-left");
+  left.append(el("div", "hud-h", "SIGNOS VITALES"));
+  const cards = el("div", "hud-cards");
+  left.append(cards);
+  left.append(el("div", "hud-h hud-h2", "ÚLTIMAS EJECUCIONES"));
+  const runsList = el("div", "hud-runs");
+  left.append(runsList);
+
+  function card(label: string, value: string, sub: string, pct: number | null): HTMLElement {
+    const c = el("div", "hud-card");
+    c.append(el("div", "hud-card-label", label), el("div", "hud-card-value", value));
+    if (pct !== null) {
+      const bar = el("div", "hud-bar");
+      const fill = el("i");
+      fill.style.width = Math.min(100, Math.max(0, pct)) + "%";
+      if (pct >= 85) fill.classList.add("hot");
+      bar.append(fill);
+      c.append(bar);
+    }
+    c.append(el("div", "hud-card-sub", sub));
+    return c;
+  }
+
+  // ── bottom: terminals bar ────────────────────────────────────────────────
+  const bar = el("div", "hud-bottom");
+  const termLabel = el("div", "hud-term-label", "TERMINALES");
+  const termCount = el("span", "hud-term-count", "0 abiertas");
+  termLabel.append(termCount);
+  const chipsWrap = el("div", "hud-term-chips");
+  const talk = el("button", "hud-talk", "Hablar");
+  talk.type = "button";
+  talk.addEventListener("click", opts.onTalk);
+  bar.append(termLabel, chipsWrap, talk);
+
+  document.body.append(brand, modes, left, bar);
+
+  // ── refresh ──────────────────────────────────────────────────────────────
+  function tickClock() {
+    const d = new Date();
+    clock.textContent = d.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit", second: "2-digit" });
+    date.textContent = d.toLocaleDateString([], { weekday: "short", day: "2-digit", month: "short" }).toUpperCase();
+  }
+  tickClock();
+  setInterval(tickClock, 1000);
+
+  async function refresh() {
+    const [limits, stats, sessions, runs] = await Promise.all([
+      getJson<{ measured?: boolean; windows?: LimitWindow[] }>("/api/usage/limits"),
+      getJson<{ total_runs: number; total_input_tokens: number; total_output_tokens: number; by_status: Record<string, number> }>("/api/runs/stats"),
+      getJson<{ sessions: SessionRow[] }>("/api/sessions"),
+      getJson<{ runs: RunRow[] }>("/api/runs?limit=4"),
+    ]);
+
+    cards.replaceChildren();
+    const w = (k: string) => limits?.windows?.find((x) => x.key === k);
+    const five = w("five_hour");
+    const seven = w("seven_day");
+    if (five?.utilization != null) cards.append(card("SESIÓN · 5 H", Math.round(five.utilization) + "%", fmtReset(five.resets_at), five.utilization));
+    if (seven?.utilization != null) cards.append(card("SEMANA · 7 D", Math.round(seven.utilization) + "%", fmtReset(seven.resets_at), seven.utilization));
+    if (!five && !seven) cards.append(card("SUSCRIPCIÓN", "—", "sin medir todavía", null));
+    if (stats) {
+      const tok = stats.total_input_tokens + stats.total_output_tokens;
+      const failed = (stats.by_status.failed ?? 0) + (stats.by_status.timed_out ?? 0);
+      cards.append(card("HOY · EJECUCIONES", String(stats.total_runs), `${fmtTokens(tok)} tokens · ${failed} fallidas`, null));
+    }
+    const sess = sessions?.sessions ?? [];
+    const blocked = sess.filter((s) => s.needs_a_human_hand).length;
+    cards.append(card("SESIONES CLAUDE CODE", String(sess.length), blocked ? `${blocked} esperando respuesta` : "ninguna bloqueada", null));
+
+    runsList.replaceChildren();
+    const rs = runs?.runs ?? [];
+    if (!rs.length) runsList.append(el("div", "hud-empty", "Aún no hay ejecuciones. Pídele a JARVIS que construya algo."));
+    for (const r of rs) {
+      const row = el("div", "hud-run");
+      const st = r.status ?? "queued";
+      const dot = el("span", "hud-dot " + st);
+      row.append(dot, el("span", "hud-run-text", (r.prompt ?? r.project ?? "ejecución").slice(0, 60)));
+      runsList.append(row);
+    }
+
+    termCount.textContent = ` · ${sess.length} ${sess.length === 1 ? "abierta" : "abiertas"}`;
+    chipsWrap.replaceChildren();
+    for (const s of sess) {
+      const chip = el("span", "hud-term-chip" + (s.needs_a_human_hand ? " needs" : ""));
+      chip.append(el("span", "hud-dot " + (s.needs_a_human_hand ? "failed" : s.state === "working" ? "running" : "idle")), s.project ?? "sesión");
+      chip.title = s.state ?? "";
+      chipsWrap.append(chip);
+    }
+  }
+  refresh();
+  setInterval(refresh, 15000);
+
+  return { refresh };
+}
